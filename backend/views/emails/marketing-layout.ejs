<!doctype html>
<html lang="<%= language %>" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title><%= subject %></title>
  <style>
    body { margin: 0; padding: 0; background: #faf5ec; }
    a { color: #b3501e; }
    @media (prefers-color-scheme: dark) {
      body, .bg { background: #1b1612 !important; }
      .card { background: #26201a !important; }
      .ink { color: #f1e8da !important; }
      .muted { color: #b9ab98 !important; }
      .rule { border-color: #3a3128 !important; }
      .verse { background: #30271e !important; }
      a { color: #ffb27d !important; }
    }
    @media (max-width: 620px) { .inner { padding: 20px 18px !important; } }
  </style>
</head>
<body class="bg" style="margin:0;padding:0;background:#faf5ec;">
  <% if (preheader) { %>
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;"><%= preheader %><%- '&nbsp;&zwnj;'.repeat(40) %></div>
  <% } %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="bg" style="background:#faf5ec;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;">
        <tr><td align="center" style="padding:0 0 16px 0;">
          <img src="<%= logoUrl %>" width="48" height="48" alt="HariHariBol" style="display:block;border:0;">
        </td></tr>
        <tr><td class="card inner" style="background:#ffffff;border-radius:14px;padding:28px 32px;font-family:-apple-system,'Segoe UI',Roboto,'Noto Sans','Noto Sans Devanagari','Noto Sans Bengali','Noto Sans Gujarati','Noto Sans Gurmukhi','Noto Sans Kannada','Noto Sans Malayalam','Noto Sans Oriya','Noto Sans Tamil','Noto Sans Telugu',Arial,sans-serif;font-size:16px;line-height:1.6;color:#2b2218;">
          <%- bodyHtml %>
        </td></tr>
        <tr><td class="muted" style="padding:18px 8px 0 8px;font-family:-apple-system,'Segoe UI',Roboto,'Noto Sans',Arial,sans-serif;font-size:12px;line-height:1.6;color:#7a6b58;text-align:center;">
          <%= footer.reason %><br>
          <a href="<%= footer.unsubscribeUrl %>"><%= footer.unsubscribeLabel %></a>
          <% if (footer.postalAddress) { %><br><%= footer.postalAddress %><% } %>
          <br>HariHariBol &middot; <%= year %>
        </td></tr>
      </table>
    </td></tr>
  </table>
  <% if (openPixel) { %><img src="<%= openPixel %>" width="1" height="1" alt="" style="display:block;border:0;width:1px;height:1px;"><% } %>
</body>
</html>
