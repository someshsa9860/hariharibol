# Credentials for the old "callvcal" S3 bucket — a one-time media migration
# source for scripts/import-legacy-media.js, kept separate from the app's own
# .env and from .env.scripts (that one is the sanatan-db scripture-text
# source; this is the previous project's actual media bucket — audio, images,
# video). Copy this file to .env.legacy-media and fill in real values;
# .env.legacy-media itself is gitignored, same as .env.

LEGACY_S3_BUCKET=callvcal
LEGACY_S3_PREFIX=ramkrishnahari/
LEGACY_AWS_REGION=ap-south-1
LEGACY_AWS_ACCESS_KEY_ID=
LEGACY_AWS_SECRET_ACCESS_KEY=
