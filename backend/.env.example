# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:5183
APP_SCHEME=hariharibol

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hariharibol

# ── Redis (cache, rate limits, BullMQ, websocket fan-out) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Tokens ──────────────────────────────────────────────────────────────────
# Access tokens are signed and verified in-process; refresh tokens are random
# and only their hash is stored. Rotate JWT_SECRET only with a deploy window —
# every live access token dies with it.
JWT_SECRET=change-me-to-a-long-random-string
# The app renews the access token about once a day, well inside its 7 days, so a
# signed-in person never meets an expired one; the refresh token lasts a year and
# is replaced on every use.
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_DAYS=365
# A refresh token spent this many seconds ago is not treated as stolen if it is
# presented again (a lost response). 0 = any reuse revokes every session.
REFRESH_REUSE_GRACE_SECONDS=300

# ── Sign-in providers ───────────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=your-android-client-id,your-ios-client-id,your-web-client-id
APPLE_BUNDLE_IDS=com.hariharibol.app

# ── Carrying people over from the old app's server ─────────────────────────
# POST /api/app/auth/legacy trades the access token the old app saved for a session here; this
# server asks the old Laravel one who the token belongs to. URL = the old server's migration route
# in full, KEY = a secret of at least 32 characters, the same as HHB_MIGRATION_KEY in the old
# server's .env (e.g. `openssl rand -hex 32`). It travels in a header, so use https unless the old
# server is on this machine. Either one blank turns the feature off (the endpoint answers 503 and
# the app keeps the old token for another day).
LEGACY_MIGRATION_URL=
LEGACY_MIGRATION_KEY=
LEGACY_MIGRATION_TIMEOUT_MS=8000

# ── Client attestation (Firebase App Check) ────────────────────────────────
# Signup is refused without a valid App Check token unless this is "false".
APP_CHECK_ENABLED=false
# Firebase service account (push + App Check). Download from the Firebase
# console and drop the JSON in backend/secrets/ — see secrets/README.md.
# Relative to the backend directory, or absolute. Wins over the FIREBASE_* trio.
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/hari-hari-bol-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── S3 (private bucket — objects are served through presigned URLs) ────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hariharibol-media
S3_PRESIGN_TTL_SECONDS=3600

# ── Book cache (weekly JSON export the app downloads for offline reading) ──
# Files land in s3://$S3_BUCKET/$BOOK_CACHE_PREFIX/ and are NEVER deleted by the
# job. Do not put an S3 lifecycle rule on this prefix.
BOOK_CACHE_ENABLED=true
BOOK_CACHE_CRON=0 0 * * 0
BOOK_CACHE_TZ=Asia/Kolkata
BOOK_CACHE_PREFIX=books/caches
BOOK_CACHE_DOWNLOAD_TTL_SECONDS=900
# A book whose text changed is exported by itself once nothing has written to it for this long.
BOOK_CACHE_QUIET_SECONDS=90

# ── AI (chat, verse passes) ─────────────────────────────────────────────────
# Which provider answers: gemini or openai. Everything goes through services/ai/, so this is
# the only thing to change to switch. (An `ai.provider` value saved in the admin panel's
# Settings page overrides it — leave that unset to be driven from here.)
AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google retires models without warning — the 2.0 models and 2.5 Flash-Lite already answer 404.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini model for the admin Translations page (separate from GEMINI_MODEL above)
TRANSLATION_GEMINI_MODEL=gemini-3.5-flash-lite
# The cheap model that writes chat summaries (context compaction).
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# Used for plans whose model tier is ADVANCED. Empty = same as GEMINI_MODEL.
GEMINI_ADVANCED_MODEL=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-6-luna works here too ($0.10 in / $0.50 out per 1M tokens): OPENAI_MODEL=gpt-6-luna
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=
# The last resort for every AI call, chat included: when OpenAI's free daily tokens are spent (or the free tier is
# off) and the provider above is not working — Gemini retired the model, over quota, down — OpenAI answers with
# this model at its paid rate. Needs OPENAI_API_KEY. Empty turns the fallback off.
AI_FALLBACK_MODEL=gpt-6-luna
# How hard a reasoning model (gpt-6-luna) thinks before it answers: none, low, medium or high. Its thinking is
# billed — and taken from the reader's wallet — as output, and the reply waits for it, so chat uses none.
# Models that do not reason ignore it.
OPENAI_REASONING_EFFORT=none

# ── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shared token on the Pub/Sub push URL for Google Play notifications.
PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PLAY_PACKAGE_NAME=com.hariharibol.app
# Share links, the /satsang invitation page and the app-link files. Blank store URLs mean no button for that store.
# PLAY_STORE_URL defaults to the Play listing of GOOGLE_PLAY_PACKAGE_NAME; APP_STORE_URL has no default (never invented).
PLAY_STORE_URL=
APP_STORE_URL=
# SHA-256 fingerprints of the Android signing certificate(s), comma separated — what /.well-known/assetlinks.json
# publishes. The Play "App signing key certificate" plus the upload key. Empty = Android app links stay off.
ANDROID_CERT_SHA256=
# The Apple team that signs the app (Universal Links: appID = <TEAMID>.<bundle id>).
APPLE_TEAM_ID=V2LNA795Y9
# Share Studio AI backgrounds: price in wallet tokens (the reader sees credits, never tokens) and the OpenAI image model.
SHARE_BACKGROUND_TOKENS=100000
OPENAI_IMAGE_MODEL=gpt-image-1
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Mail (OTP and transactional) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HariHariBol <no-reply@hariharibol.com>"

# ── Ports for the sidecar containers ───────────────────────────────────────
WS_PORT=4001
DEEPLINK_PORT=4002

# ── Docs ────────────────────────────────────────────────────────────────────
# Set to false in production if the reference should not be public.
DOCS_ENABLED=true

# Translation pipeline (scripts/translate-claude.js, and the admin Translations page). It uses GPT-6 Luna unless told
# otherwise, so OPENAI_API_KEY (above) is the key it needs. Claude (key from console.anthropic.com) and Gemini are
# optional, for a part that needs more care; each part can use its own provider.
# TRANSLATION_PROVIDER=openai
# TRANSLATION_OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Version a translation run is stamped with. Every translated item and the run's checkpoint carry it,
# so a later run with a new value can be compared with this one. Fixed for a run. Default: 1.0-12-10-26
TRANSLATION_VERSION=1.0-12-10-26
# The admin panel's Translations page runs the same pipeline in the worker. It reads the English from, and
# saves the translations to, this app's own bucket (S3_BUCKET, under json/bhagavat-gita/) with the AWS keys
# above, so nothing more is needed here. Those keys must be allowed to WRITE under json/bhagavat-gita/.
# (The command line reads SOURCE_S3_BUCKET from .env.scripts instead; set it here only to point the server
# at a different bucket.)
