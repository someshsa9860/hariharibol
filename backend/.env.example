# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
APP_SCHEME=hariharibol

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hariharibol

# ── Redis (cache, rate limits, BullMQ, websocket fan-out) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Tokens ──────────────────────────────────────────────────────────────────
# Access tokens are signed and verified in-process; refresh tokens are random
# and only their hash is stored. Rotate JWT_SECRET only with a deploy window —
# every live access token dies with it.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_DAYS=365

# ── Sign-in providers ───────────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=your-android-client-id,your-ios-client-id,your-web-client-id
APPLE_BUNDLE_IDS=com.hariharibol.app

# ── Client attestation (Firebase App Check) ────────────────────────────────
# Signup is refused without a valid App Check token unless this is "false".
APP_CHECK_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── S3 (private bucket — objects are served through presigned URLs) ────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hariharibol-media
S3_PRESIGN_TTL_SECONDS=3600

# ── AI (provider and model are overridable from AppSetting at runtime) ─────
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shared token on the Pub/Sub push URL for Google Play notifications.
PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PLAY_PACKAGE_NAME=com.hariharibol.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Mail (OTP and transactional) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HariHariBol <no-reply@hariharibol.com>"

# ── Ports for the sidecar containers ───────────────────────────────────────
WS_PORT=4001
DEEPLINK_PORT=4002

# ── Docs ────────────────────────────────────────────────────────────────────
# Set to false in production if the reference should not be public.
DOCS_ENABLED=true
