# Credentials for the previous project's S3 bucket — a one-time migration
# source for scripts/import-*.js, kept separate from the app's own .env on
# purpose (see scripts/README.md). Copy this file to .env.scripts and fill in
# real values; .env.scripts itself is gitignored, same as .env.

SOURCE_S3_BUCKET=sanatan-db
SOURCE_AWS_REGION=ap-south-1
SOURCE_AWS_ACCESS_KEY_ID=
SOURCE_AWS_SECRET_ACCESS_KEY=
