{
  "slug": "bhaja-govindam",
  "title": "Bhaja Govindam",
  "titleOriginal": "भज गोविन्दम्",
  "category": "other",
  "sortOrder": 30,
  "originalLanguage": "sa",
  "summary": "Worship Govinda, foolish mind: grammar will not save you at the time of death.",
  "about": "A song against wasting life on learning and wealth alone, urging the mind to worship Govinda. The first twelve verses are Śaṅkara’s; tradition gives the later ones to the disciples who were with him.",
  "author": "Śaṅkarācārya",
  "reference": "Moha-mudgara",
  "sourceName": "Wikisource (Sanskrit), CC BY-SA 4.0",
  "sourceUrl": "https://sa.wikisource.org/wiki/%E0%A4%AD%E0%A4%9C%E0%A4%97%E0%A5%8B%E0%A4%B5%E0%A4%BF%E0%A4%A8%E0%A5%8D%E0%A4%A6%E0%A4%AE%E0%A5%8D",
  "tradition": "smarta",
  "deity": "krishna",
  "occasions": [
    "any time"
  ],
  "festivals": [],
  "verses": [
    {
      "position": 1,
      "text": "भज गोविन्दं भज गोविन्दं\nगोविन्दं भज मूढमते ।\nसंप्राप्ते सन्निहिते काले\nनहि नहि रक्षति डुकृञ्करणे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "मूढ जहीहि धनागमतृष्णां\nकुरु सद्बुद्धिं मनसि वितृष्णाम् ।\nयल्लभसे निजकर्मोपात्तं\nवित्तं तेन विनोदय चित्तम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "नारीस्तनभरनाभीदेशं\nदृष्ट्वा मा गा मोहावेशम् ।\nएतन्मांसावसादि विकारं\nमनसि विचिन्तय वारं वारम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "नलिनीदलगतजलमतितरलं\nतद्वज्जीवितमतिशयचपलम् ।\nविद्धि व्याध्यभिमानग्रस्तं\nलोकं शोकहतं च समस्तम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "यावद्वित्तोपार्जनसक्तः\nतावन्निजपरिवारो रक्तः ।\nपश्चाज्जीवति जर्जरदेहे\nवार्तां कोऽपि न पृच्छति गेहे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "यावत्पवनो निवसति देहे\nतावत्पृच्छति कुशलं गेहे ।\nगतवति वायौ देहापाये\nभार्या बिभ्यति तस्मिन्काये ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "बालस्तावत्क्रीडासक्तः\nतरुणस्तावत्तरुणीसक्तः ।\nवृद्धस्तावच्चिन्तासक्तः\nपरे ब्रह्मणि कोऽपि न सक्तः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "का ते कान्ता कस्ते पुत्रः\nसंसारोऽयमतीव विचित्रः ।\nकस्य त्वं कः कुत आयातः\nतत्त्वं चिन्तय तदिह भ्रातः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 9,
      "text": "सत्सङ्गत्वे निस्सङ्गत्वं\nनिस्सङ्गत्वे निर्मोहत्वम् ।\nनिर्मोहत्वे निश्चलतत्त्वं\nनिश्चलतत्त्वे जीवन्मुक्तिः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 10,
      "text": "वयसि गते कः कामविकारः\nशुष्के नीरे कः कासारः ।\nक्षीणे वित्ते कः परिवारः\nज्ञाते तत्त्वे कः संसारः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 11,
      "text": "मा कुरु धनजनयौवनगर्वं\nहरति निमेषात्कालः सर्वम् ।\nमायामयमिदमखिलं हित्वा\nब्रह्मपदं त्वं प्रविश विदित्वा ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 12,
      "text": "दिनयामिन्यौ सायं प्रातः\nशिशिरवसन्तौ पुनरायातः ।\nकालः क्रीडति गच्छत्यायुः\nतदपि न मुञ्चत्याशावायुः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 13,
      "text": "द्वादशमञ्जरिकाभिरशेषः\nकथितो वैयाकरणस्यैषः ।\nउपदेशोऽभूद्विद्यानिपुणैः\nश्रीमच्छङ्करभगवच्छरणैः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 14,
      "text": "का ते कान्ताधनगतचिन्ता\nवातुल किं तव नास्ति नियन्ता ।\nत्रिजगति सज्जनसङ्गतिरैका\nभवति भवार्णवतरणे नौका ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 15,
      "text": "जटिलो मुण्डी लुञ्छितकेशः\nकाषायाम्बरबहुकृतवेषः ।\nपश्यन्नपि च न पश्यति मूढः\nउदरनिमित्तं बहुकृतवेषः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 16,
      "text": "अङ्गं गलितं पलितं मुण्डं\nदशनविहीनं जातं तुण्डम् ।\nवृद्धो याति गृहीत्वा दण्डं\nतदपि न मुञ्चत्याशापिण्डम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 17,
      "text": "अग्रे वह्निः पृष्ठे भानुः\nरात्रौ चुबुकसमर्पितजानुः ।\nकरतलभिक्षस्तरुतलवासः\nतदपि न मुञ्चत्याशापाशः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 18,
      "text": "कुरुते गङ्गासागरगमनं\nव्रतपरिपालनमथवा दानम् ।\nज्ञानविहीनः सर्वमतेन\nमुक्तिं न भजति जन्मशतेन ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 19,
      "text": "सुरमन्दिरतरुमूलनिवासः\nशय्या भूतलमजिनं वासः ।\nसर्वपरिग्रहभोगत्यागः\nकस्य सुखं न करोति विरागः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 20,
      "text": "योगरतो वा भोगरतो वा\nसङ्गरतो वा सङ्गविहीनः ।\nयस्य ब्रह्मणि रमते चित्तं\nनन्दति नन्दति नन्दत्येव ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 21,
      "text": "भगवद्गीता किञ्चिदधीता\nगङ्गाजललवकणिका पीता ।\nसकृदपि येन मुरारिसमर्चा\nक्रियते तस्य यमेन न चर्चा ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 22,
      "text": "पुनरपि जननं पुनरपि मरणं\nपुनरपि जननी जठरे शयनम् ।\nइह संसारे बहुदुस्तारे\nकृपयाऽपारे पाहि मुरारे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 23,
      "text": "रथ्याचर्पटविरचितकन्थः\nपुण्यापुण्यविवर्जितपन्थः ।\nयोगी योगनियोजितचित्तो\nरमते बालोन्मत्तवदेव ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 24,
      "text": "कस्त्वं कोऽहं कुत आयातः\nका मे जननी को मे तातः ।\nइति परिभावय सर्वमसारं\nविश्वं त्यक्त्वा स्वप्नविचारम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 25,
      "text": "त्वयि मयि चान्यत्रैको विष्णुः\nव्यर्थं कुप्यसि मय्यसहिष्णुः ।\nभव समचित्तः सर्वत्र त्वं\nवाञ्छस्यचिराद्यदि विष्णुत्वम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 26,
      "text": "शत्रौ मित्रे पुत्रे बन्धौ\nमा कुरु यत्नं विग्रहसन्धौ ।\nसर्वस्मिन्नपि पश्यात्मानं\nसर्वत्रोत्सृज भेदाज्ञानम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 27,
      "text": "कामं क्रोधं लोभं मोहं\nत्यक्त्वाऽऽत्मानं भावय कोऽहम् ।\nआत्मज्ञानविहीना मूढाः\nते पच्यन्ते नरकनिगूढाः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 28,
      "text": "गेयं गीतानामसहस्रं\nध्येयं श्रीपतिरूपमजस्रम् ।\nनेयं सज्जनसङ्गे चित्तं\nदेयं दीनजनाय च वित्तम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 29,
      "text": "सुखतः क्रियते रामाभोगः\nपश्चाद्धन्त शरीरे रोगः ।\nयद्यपि लोके मरणं शरणं\nतदपि न मुञ्चति पापाचरणम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 30,
      "text": "अर्थमनर्थं भावय नित्यं\nनास्ति ततः सुखलेशः सत्यम् ।\nपुत्रादपि धनभाजां भीतिः\nसर्वत्रैषा विहिता रीतिः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 31,
      "text": "प्राणायामं प्रत्याहारं\nनित्यानित्यविवेकविचारम् ।\nजाप्यसमेतसमाधिविधानं\nकुर्ववधानं महदवधानम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 32,
      "text": "गुरुचरणाम्बुजनिर्भरभक्तः\nसंसारादचिराद्भव मुक्तः ।\nसेन्द्रियमानसनियमादेवं\nद्रक्ष्यसि निजहृदयस्थं देवम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 33,
      "text": "मूढः कश्चन वैयाकरणो\nडुकृञ्करणाध्ययनधुरीणः ।\nश्रीमच्छङ्करभगवच्छिष्यैः\nबोधित आसिच्छोधितकरणः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 34,
      "text": "भज गोविन्दं भज गोविन्दं\nगोविन्दं भज मूढमते ।\nनामस्मरणादन्यमुपायं\nनहि पश्यामो भवतरणे ॥",
      "roman": null,
      "meaning": null
    }
  ],
