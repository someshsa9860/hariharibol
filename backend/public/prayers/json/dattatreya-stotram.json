  ],
  "festivals": [
    "datta-jayanti",
    "purnima"
  ],
  "verses": [
    {
      "position": 1,
      "intro": true,
      "text": "जटाधरं पांडुरंगं शूलहस्तं कृपानिधिम् ।\nसर्वरोगहरं देवं दत्तात्रेयमहं भजे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "जगदुत्पत्तिकर्त्रे च स्थितिसंहार हेतवे ।\nभवपाशविमुक्ताय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "जराजन्मविनाशाय देहशुद्धिकराय च ।\nदिगम्बरदयामूर्ते दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "कर्पूरकान्तिदेहाय ब्रह्ममूर्तिधराय च ।\nवेदशास्त्रपरिज्ञाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "ह्रस्वदीर्घकृशस्थूल-नामगोत्र-विवर्जित ।\nपंचभूतैकदीप्ताय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "यज्ञभोक्ते च यज्ञाय यज्ञरूपधराय च ।\nयज्ञप्रियाय सिद्धाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "आदौ ब्रह्मा मध्ये विष्णुरन्ते देवः सदाशिवः ।\nमूर्तित्रयस्वरूपाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "भोगालयाय भोगाय योगयोग्याय धारिणे ।\nजितेन्द्रियजितज्ञाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 9,
      "text": "दिगम्बराय दिव्याय दिव्यरूपधराय च ।\nसदोदितपरब्रह्म दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 10,
      "text": "जम्बुद्वीपमहाक्षेत्रमातापुरनिवासिने ।\nजयमानसतां देव दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 11,
      "text": "भिक्षाटनं गृहे ग्रामे पात्रं हेममयं करे ।\nनानास्वादमयी भिक्षा दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 12,
      "text": "ब्रह्मज्ञानमयी मुद्रा वस्त्रे चाकाशभूतले ।\nप्रज्ञानघनबोधाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 13,
      "text": "अवधूतसदानन्दपरब्रह्मस्वरूपिणे ।\nविदेहदेहरूपाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 14,
      "text": "सत्यरूपसदाचारसत्यधर्मपरायण ।\nसत्याश्रयपरोक्षाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 15,
      "text": "शूलहस्तगदापाणे वनमालासुकन्धर ।\nयज्ञसूत्रधरब्रह्मन् दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 16,
      "text": "क्षराक्षरस्वरूपाय परात्परतराय च ।\nदत्तमुक्तिपरस्तोत्र दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 17,
      "text": "दत्त विद्याढ्यलक्ष्मीश दत्त स्वात्मस्वरूपिणे ।\nगुणनिर्गुणरूपाय दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 18,
      "text": "शत्रुनाशकरं स्तोत्रं ज्ञानविज्ञानदायकम् ।\nसर्वपापं शमं याति दत्तात्रेय नमोऽस्तुते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 19,
      "text": "इदं स्तोत्रं महद्दिव्यं दत्तप्रत्यक्षकारकम् ।\nदत्तात्रेयप्रसादाच्च नारदेन प्रकीर्तितम् ॥",
      "roman": null,
      "meaning": null
    }
  ],
