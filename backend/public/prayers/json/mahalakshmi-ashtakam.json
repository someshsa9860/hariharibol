  "verses": [
    {
      "position": 1,
      "text": "नमस्तेऽस्तु महामाये श्रीपीठे सुरपूजिते ।\nशंखचक्रगदाहस्ते महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "नमस्ते गरुडारूढे कोलासुरभयंकरि ।\nसर्वपापहरे देवि महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "सर्वज्ञे सर्ववरदे सर्वदुष्टभयंकरि ।\nसर्वदुःखहरे देवि महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "सिद्धिबुद्धिप्रदे देवि भुक्तिमुक्तिप्रदायिनि ।\nमंत्रमूर्ते सदा देवि महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "आद्यंतरहिते देवि आद्यशक्ति महेश्वरि ।\nयोगजे योगसंभूते महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "स्थूलसूक्ष्ममहारौद्रे महाशक्ति महोदरे ।\nमहापापहरे देवि महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "पद्मासनस्थिते देवि परब्रह्मस्वरूपिणि ।\nपरमेशि जगन्मातर्महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "श्वेतांबरधरे देवि नानालंकारभूषिते ।\nजगत्स्थिते जगन्मातर्महालक्ष्मि नमोऽस्तु ते ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 9,
      "text": "महालक्ष्म्यष्टकं स्तोत्रं यः पठेद्भक्तिमान्नरः ।\nसर्वसिद्धिमवाप्नोति राज्यं प्राप्नोति सर्वदा ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 10,
      "text": "एककाले पठेन्नित्यं महापापविनाशनम् ।\nद्विकालं यः पठेन्नित्यं धनधान्यसमन्वितः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 11,
      "text": "त्रिकालं यः पठेन्नित्यं महाशत्रुविनाशनम् ।\nमहालक्ष्मीर्भवेन्नित्यं प्रसन्ना वरदा शुभा ॥",
      "roman": null,
      "meaning": null
    }
  ],
