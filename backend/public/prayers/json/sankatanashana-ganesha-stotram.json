  "verses": [
    {
      "position": 1,
      "text": "प्रणम्य शिरसा देवं गौरीपुत्रं विनायकम् ।\nभक्तावासं स्मरेन्नित्यं आयुःकामार्थसिद्धये ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "प्रथमं वक्रतुण्डं च एकदन्तं द्वितीयकम् ।\nतृतीयं कृष्णपिङ्गाक्षं गजवक्त्रं चतुर्थकम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "लम्बोदरं पञ्चमं च षष्ठं विकटमेव च ।\nसप्तमं विघ्नराजेन्द्रं धूम्रवर्णं तथाष्टमम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "नवमं भालचन्द्रं च दशमं तु विनायकम् ।\nएकादशं गणपतिं द्वादशं तु गजाननम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "द्वादशैतानि नामानि त्रिसंध्यं यः पठेन्नरः ।\nन च विघ्नभयं तस्य सर्वसिद्धिकरः प्रभुः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "विद्यार्थी लभते विद्यां धनार्थी लभते धनम् ।\nपुत्रार्थी लभते पुत्रान्मोक्षार्थी लभते गतिम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "जपेद्गणपतिस्तोत्रं षड्भिर्मासैः फलं लभेत् ।\nसंवत्सरेण सिद्धिं च लभते नात्र संशयः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "अष्टेभ्यो ब्राह्मणेभ्यश्च लिखित्वा यः समर्पयेत् ।\nतस्य विद्या भवेत्सर्वा गणेशस्य प्रसादतः ॥",
      "roman": null,
      "meaning": null
    }
  ],
