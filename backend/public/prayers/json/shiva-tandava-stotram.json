  "verses": [
    {
      "position": 1,
      "text": "जटाऽटवीगलज्जलप्रवाहपावितस्थले गलेऽवलम्ब्य लम्बितां भुजङ्गतुङ्गमालिकाम् ।\nडमड्डमड्डमड्डमन्निनादवड्डमर्वयं चकार चण्डताण्डवं तनोतु नः शिवः शिवम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "जटाकटाहसम्भ्रमभ्रमन्निलिम्पनिर्झरीविलोलवीचिवल्लरीविराजमानमूर्द्धनि ।\nधगद्धगद्धगज्ज्वलल्ललाटपट्टपावके किशोरचन्द्रशेखरे रतिः प्रतिक्षणं मम ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "धराधरेन्द्रनन्दिनीविलासबन्धुबन्धुरस्फुरद्दिगन्तसन्ततिप्रमोदमानमानसे ।\nकृपाकटाक्षधोरणीनिरुद्धदुर्धरापदि क्वचिद्दिगम्बरे मनो विनोदमेतु वस्तुनि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "जटाभुजङ्गपिङ्गलस्फुरत्फणामणिप्रभाकदम्बकुङ्कुमद्रवप्रलिप्तदिग्वधूमुखे ।\nमदान्धसिन्धुरासुरत्वगुत्तरीयमेदुरे मनो विनोदमद्भुतं बिभर्तु भूतभर्तरि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "सहस्रलोचनप्रभृत्यशेषलेखशेखरप्रसूनधूलिधोरणीविधूसराङ्घ्रिपीठभूः ।\nभुजङ्गराजमालया निबद्धजाटजूटकः श्रिये चिराय जायतां चकोरबन्धुशेखरः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "ललाटचत्वरज्वलद्धनञ्जयस्फुलिङ्गभानिपीतपञ्चसायकं नमन्निलिम्पनायकम् ।\nसुधामयूखलेखया विराजमानशेखरं महः कपालि सम्पदे सरिज्जटालमस्तु नः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "करालभालपट्टिकाधगद्धगद्धगज्ज्वलद्धनञ्जयाहुतीकृतप्रचण्डपञ्चसायके ।\nधराधरेन्द्रनन्दिनीकुचाग्रचित्रपत्रकप्रकल्पनैकशिल्पिनि त्रिलोचने रतिर्मम ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "नवीनमेघमण्डलीनिरुद्धदुर्धरस्फुरत्कुहूनिशीथिनीतमःप्रबन्धबद्धकन्धरः ।\nनिलिम्पनिर्झरीधरस्तनोतु कृत्तिसिन्धुरः कलानिधानबन्धुरः श्रियं जगद्धुरन्धरः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 9,
      "text": "प्रफुल्लनीलपङ्कजप्रपञ्चकालिमप्रभाऽवलम्बिकण्ठकन्दलीरुचिप्रबद्धकन्धरम् ।\nस्मरच्छिदं पुरच्छिदं भवच्छिदं मखच्छिदं गजच्छिदान्धकच्छिदं तमन्तकच्छिदं भजे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 10,
      "text": "अखर्वसर्वमङ्गलाकलाकदम्बमञ्जरीरसप्रवाहमाधुरीविजृम्भणामधुव्रतम् ।\nस्मरान्तकं पुरान्तकं भवान्तकं मखान्तकं गजान्तकान्धकान्तकं तमन्तकान्तकं भजे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 11,
      "text": "जयत्वदभ्रविभ्रमभ्रमद्भुजङ्गमश्वसद्विनिर्गमत्क्रमस्फुरत्करालभालहव्यवाट् ।\nधिमिद्धिमिद्धिमिद्ध्वनन्मृदङ्गतुङ्गमङ्गलध्वनिक्रमप्रवर्तितप्रचण्डताण्डवः शिवः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 12,
      "text": "दृषद्विचित्रतल्पयोर्भुजङ्गमौक्तिकस्रजोर्गरिष्ठरत्नलोष्ठयोः सुहृद्विपक्षपक्षयोः ।\nतृणारविन्दचक्षुषोः प्रजामहीमहेन्द्रयोः समप्रवृत्तिकः कदा सदाशिवं भजाम्यहम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 13,
      "text": "कदा निलिम्पनिर्झरीनिकुञ्जकोटरे वसन् विमुक्तदुर्मतिः सदा शिरःस्थमञ्जलिं वहन् ।\nविमुक्तलोललोचनाललामभाललग्नकं शिवेति मन्त्रमुच्चरन् कदा सुखी भवाम्यहम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 14,
      "text": "निलिम्पनाथनागरीकदम्बमौलमल्लिकानिगुम्फनिर्भरक्षरन्मधूष्णिकामनोहरः ।\nतनोतु नो मनोमुदं विनोदिनीमहर्निशं परश्रियः परं पदं तदङ्गजत्विषां चयः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 15,
      "text": "प्रचण्डवाडवानलप्रभाशुभप्रचारणी महाष्टसिद्धिकामिनीजनाऽवहूतजल्पना ।\nविमुक्तवामलोचनाविवाहकालिकध्वनिः शिवेति मन्त्रभूषणा जगज्जयाय जायताम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 16,
      "text": "इमं हि नित्यमेवमुक्तमुत्तमोत्तमं स्तवं पठन्स्मरन्ब्रुवन्नरो विशुद्धिमेति सन्ततम् ।\nहरे गुरौ सुभक्तिमाशु याति नाऽन्यथा गतिं विमोहनं हि देहिनां सुशङ्करस्य चिन्तनम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 17,
      "text": "पूजावसानसमये दशवक्त्रगीतं यः शम्भुपूजनपरं पठति प्रदोषे ।\nतस्य स्थिरां रथगजेन्द्रतुरङ्गयुक्तां लक्ष्मीं प्रसादसमये प्रददाति शम्भुः ॥",
      "roman": null,
      "meaning": null
    }
  ],
