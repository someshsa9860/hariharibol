  "verses": [
    {
      "position": 1,
      "text": "अपराधसहस्राणि क्रियन्तेऽहर्निशं मया ।\nदासोऽयमिति मां मत्वा क्षमस्व परमेश्वरि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "आवाहनं न जानामि न जानामि विसर्जनम् ।\nपूजां चैव न जानामि क्षम्यतां परमेश्वरि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "मन्त्रहीनं क्रियाहीनं भक्तिहीनं सुरेश्वरि ।\nयत्पूजितं मया देवि परिपूर्णं तदस्तु मे ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "अपराधशतं कृत्वा जगदम्बेति चोच्चरेत् ।\nयां गतिं समवाप्नोति न तां ब्रह्मादयः सुराः ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "सापराधोऽस्मि शरणं प्राप्तस्त्वां जगदम्बिके ।\nइदानीमनुकम्प्योऽहं यथेच्छसि तथा कुरु ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "अज्ञानाद्विस्मृतेर्भ्रान्त्या यन्न्यूनमधिकं कृतम् ।\nतत्सर्वं क्षम्यतां देवि प्रसीद परमेश्वरि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "कामेश्वरि जगन्मातः सच्चिदानन्दविग्रहे ।\nगृहाणार्चामिमां प्रीत्या प्रसीद परमेश्वरि ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "गुह्यातिगुह्यगोप्त्री त्वं गृहाणास्मत्कृतं जपम् ।\nसिद्धिर्भवतु मे देवि त्वत्प्रसादात्सुरेश्वरि ॥",
      "roman": null,
      "meaning": null
    }
  ],
