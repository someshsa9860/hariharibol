  "verses": [
    {
      "position": 1,
      "text": "ब्रह्ममुरारि सुरार्चित लिङ्गम्\nनिर्मलभासितशोभितलिङ्गम् ।\nजन्मजदुःखविनाशकलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "देवमुनिप्रवरार्चितलिङ्गम्\nकामदहनकरुणाकरलिङ्गम् ।\nरावणदर्पविनाशनलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "सर्वसुगन्धसुलेपितलिङ्गम्\nबुद्धिविवर्धनकारणलिङ्गम् ।\nसिद्धसुरासुरवन्दितलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "कनकमहामणिभूषितलिङ्गम्\nफणिपतिवेष्टितशोभितलिङ्गम् ।\nदक्षसुयज्ञविनाशनलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "कुङ्कुमचन्दनलेपितलिङ्गम्\nपङ्कजहारसुशोभितलिङ्गम् ।\nसञ्चितपापविनाशनलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "देवगणार्चितसेवितलिङ्गम्\nभावैर्भक्तिभिरेव च लिङ्गम् ।\nदिनकरकोटिप्रभाकरलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 7,
      "text": "अष्टदलोपरिवेष्टितलिङ्गम्\nसर्वसमुद्भवकारणलिङ्गम् ।\nअष्टदरिद्रविनाशनलिङ्गम्\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 8,
      "text": "सुरगुरुसुरवरपूजितलिङ्गम्\nसुरवनपुष्पसदार्चितलिङ्गम् ।\nपरात्परं परमात्मकलिङ्गं\nतत्प्रणमामि सदाशिवलिङ्गम् ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 9,
      "text": "लिङ्गाष्टकमिदं पुण्यं यः पठेच्छिवसन्निधौ ।\nशिवलोकमवाप्नोति शिवेन सह मोदते ॥",
      "roman": null,
      "meaning": null
    }
  ],
