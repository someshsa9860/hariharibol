  "verses": [
    {
      "position": 1,
      "text": "नागेन्द्रहाराय त्रिलोचनाय\nभस्माङ्गरागाय महेश्वराय ।\nनित्याय शुद्धाय दिगम्बराय\nतस्मै नकाराय नमःशिवाय ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 2,
      "text": "मन्दाकिनीसलिलचन्दनचर्चिताय\nनन्दीश्वरप्रमथनाथमहेश्वराय ।\nमन्दारपुष्पबहुपुष्पसुपूजिताय\nतस्मै मकाराय नमःशिवाय ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 3,
      "text": "शिवाय गौरीवदनाब्जवृन्द\nसूर्याय दक्षाध्वरनाशकाय ।\nश्रीनीलकण्ठाय वृषध्वजाय\nतस्मै शिकाराय नमःशिवाय ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 4,
      "text": "वसिष्ठकुम्भोद्भवगौतमार्य\nमुनीन्द्रदेवार्चितशेखराय ।\nचन्द्रार्कवैश्वानरलोचनाय\nतस्मै वकाराय नमःशिवाय ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 5,
      "text": "यक्षस्वरूपाय जटाधराय\nपिनाकहस्ताय सनातनाय ।\nदिव्याय देवाय दिगम्बराय\nतस्मै यकाराय नमःशिवाय ॥",
      "roman": null,
      "meaning": null
    },
    {
      "position": 6,
      "text": "पञ्चाक्षरमिदं पुण्यं यः पठेत् शिवसन्निधौ ।\nशिवलोकमवाप्नोति शिवेन सह मोदते ॥",
      "roman": null,
      "meaning": null
    }
  ],
