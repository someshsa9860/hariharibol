// HariHariBol — database schema
//
// Two halves:
//   1. Auth & access — users, roles, permissions, devices, refresh tokens
//   2. Content       — books, cantos, chapters, verses, translators, translations
//
// Scope note: Vaishnav only for now. Every content row carries a `sampradaya`
// field so other sampradayas can be added later without a migration that has to
// guess what existing rows belong to.
//
// Media (audio, images) is stored in a private S3 bucket. These columns hold the
// object key, never a URL — links are presigned at response time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum AuthProvider {
  GOOGLE
  APPLE
  // Carried over from the old app's server (POST /auth/legacy). Such an account has no
  // Google or Apple identity yet; the first verified sign-in that matches its email adopts
  // it and this value becomes GOOGLE or APPLE. See "Legacy users" in backend/CLAUDE.md.
  LEGACY
}

// What kind of work a Book row is. SCRIPTURE has chapters (and cantos for SB);
// everything else is short-form and hangs its verses directly off the book.
enum ContentType {
  SCRIPTURE
  STOTRA
  AARTI
  PRAYER
  POEM
  TEXT
}

enum VerseType {
  SHLOKA // metered Sanskrit verse
  PROSE // prose passage
  LINE // a line of an aarti, bhajan or poem
  REFRAIN // repeated chorus line
  MANTRA // chanted mantra
}

enum TranslationType {
  TRANSLATION // plain rendering of the verse
  COMMENTARY // purport / explanation
  POETIC_EXPANSION // e.g. Dnyaneshwari's ovis expanding a BG verse
}

enum ChantSource {
  IN_APP // counted bead by bead inside the app
  MANUAL // entered afterwards, chanted on physical beads
}

enum SlokaSource {
  MANUAL // picked by an admin
  RULE // picked by the personalisation rules
  AI // generated
}

enum IssueCategory {
  VIKARA // the six inner enemies: kama, krodha, lobha, moha, mada, matsarya
  PRACTICE // sadhana difficulties: missed chanting time, unmet round target
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
  MOVED // pushed to a later day; a successor row carries it forward
  SKIPPED
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum TranslationRunStatus {
  QUEUED // waiting for the worker (one run at a time)
  RUNNING
  PAUSED // stopped on something outside the run — no credit, a busy API; see pauseReason
  COMPLETED
  FAILED // broke on something unexpected; Resume tries again from the first unsaved verse
  CANCELLED
}

enum NotificationType {
  SLOKA // the daily sloka
  SADHANA // chanting or task reminders
  ANNOUNCEMENT // broadcast from admin
  SYSTEM // account, payment, security
  REEL // someone engaged with your reel, or with you as a creator
  REFERRAL // a referral qualified and earned a month
  FESTIVAL // an upcoming Ekadashi, Chaturthi or festival
}

enum VerseLinkRelation {
  SAME_CONCEPT
  EXPANDS_ON
  QUOTED_IN
  CONTRASTS_WITH
}

// What sort of curated reading a Story is. Governs nothing structurally —
// StoryPart looks the same either way — but it is what a listing screen
// groups and titles its sections by.
enum StoryKind {
  DEVOTEE_STORY // a devotee's life and pastimes: Prahlada, Dhruva, Ajamila, Gajendra…
  GURU_LESSON // a numbered teaching cycle, e.g. Dattatreya's twenty-four gurus
  KAVACHA // a protective stotra, e.g. Narayana Kavacha
}

enum PaymentProvider {
  GOOGLE_PLAY
  APPLE_APP_STORE
  RAZORPAY
}

enum PaymentPurpose {
  SUBSCRIPTION
  DONATION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum FeatureKind {
  FLAG // on or off
  LIMIT // a number — a quota or a cap
}

enum SubscriptionStatus {
  IN_TRIAL
  ACTIVE
  GRACE // renewal failed; still entitled while the provider retries
  CANCELLED // will not renew, but entitled until currentPeriodEnd
  EXPIRED
  REFUNDED
}

enum CreatorStatus {
  PENDING // applied, awaiting review
  APPROVED
  REJECTED
  SUSPENDED // was approved, posting rights pulled
}

enum ReelMediaType {
  VIDEO
  IMAGE // one or more photos, shown as a slideshow — see ReelMedia
  AUDIO // a recitation/narration, no video — see ReelAudioTrack
}

enum ReelStatus {
  DRAFT // creator has not submitted it yet
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  TAKEN_DOWN // was published, removed after the fact
}

enum SharePlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TWITTER
  TELEGRAM
  COPY_LINK
  OTHER
}

enum ReportReason {
  SPAM
  HARASSMENT_OR_ABUSE
  NON_DEVOTIONAL // does not belong on a devotional platform
  MISINFORMATION
  SEXUAL_OR_VIOLENT
  OTHER
}

// ============================================================================
// Auth & access
// ============================================================================

// One table for everyone. An admin is a User whose Role carries admin
// permissions — there is no separate admin account type.
model User {
  id String @id @default(cuid())

  email          String       @unique @db.VarChar(255)
  name           String?
  avatarUrl      String?
  authProvider   AuthProvider
  providerUserId String       @unique

  // The id this person had on the old app's server, set only on an account carried over
  // from it. It is what makes the carry-over safe to repeat: the same old account always
  // lands on the same row here, however many times a phone asks.
  legacyUserId Int? @unique

  // Three independent language choices. They may all differ, or all match —
  // nothing is derived from another.
  //   appLanguage     — UI chrome. Most users pick English.
  //   mantraLanguage  — the script a mantra is displayed in (sa/hi/mr/en/native).
  //                     No longer asked of the reader outside onboarding: the app shows
  //                     a mantra's text in the reading language, so this is only the
  //                     next choice after it.
  //   readingLanguage — what they read and listen to content in.
  //
  // Resolving mantra text: readingLanguage → mantraLanguage → appLanguage → "en" → "sa".
  // Resolving verse translations: readingLanguage → appLanguage → "en".
  appLanguage     String @default("en") @db.VarChar(10)
  mantraLanguage  String @default("sa") @db.VarChar(10)
  readingLanguage String @default("en") @db.VarChar(10)

  // Decides when this user's day starts and when scheduled jobs may reach them.
  // Lives here rather than on SadhanaProfile because that row is optional, and
  // the sloka cron needs a timezone for every user.
  timezone String @default("Asia/Kolkata") @db.VarChar(64)

  // Which tradition this person's chanting says they follow — "shaiva",
  // "vaishnav", whatever `Mantra.sampradaya` carries. Null until some tradition
  // has been chanted on enough separate days to say.
  //
  // Never chosen by the user and never edited by hand: it is a cache that
  // services/sampradaya.js owns, rebuildable from ChantSession at any time.
  sampradaya String? @db.VarChar(50)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Entitlement, cached here because it is checked on ordinary requests and a
  // join per request is not worth it. Derived — the payment webhooks and the
  // daily job own it, and it can always be rebuilt from Subscription + Payment.
  //
  // Earned two ways: an active subscription, or any donation of any amount.
  // `premiumUntil` null while isPremium is true means it never lapses, which is
  // how donors are held — they gave once and keep access.
  isPremium    Boolean   @default(false)
  premiumSince DateTime?
  premiumUntil DateTime?

  isBanned     Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActiveAt DateTime @default(now())

  devices       Device[]
  refreshTokens RefreshToken[]

  sadhanaProfile   SadhanaProfile?
  sadhanaDays      SadhanaDay[]
  chantSessions    ChantSession[]
  chantMalas       ChantMala[]
  chantTranscripts ChantTapTranscript[]
  sadhanaTasks     SadhanaTask[]
  routineTasks     RoutineTask[]
  routineDaily     RoutineDailyItem[]
  routineChecks    RoutineCheck[]
  dailySlokas      UserDailySloka[]
  issues           UserIssue[]
  preferences      UserPreferenceProfile?
  subscriptions    Subscription[]
  payments         Payment[]

  aiWallet          AiWallet?
  aiWalletTxns      AiWalletTransaction[]
  aiDailyUsage      AiDailyUsage[]
  chatConversations ChatConversation[]

  shareLinks        ShareLink[]
  activeDays UserActiveDay[]
  referralCode      ReferralCode?
  referralsMade     Referral[]         @relation("Referrer")
  referredBy        Referral?          @relation("Referee")
  entitlementGrants EntitlementGrant[]
  shareImageJobs    ShareImageJob[]

  favorites       Favorite[]
  readingProgress ReadingProgress[]
  verseNotes      VerseNote[]
  verseHighlights VerseHighlight[]
  notifications   Notification[]

  // A user becomes a creator by having this row, not by a different Role — role
  // governs admin-panel access levels (user/moderator/admin), which is orthogonal
  // to "can this person post reels". Same pattern as SadhanaProfile.
  creatorProfile   CreatorProfile?
  creatorFollows   CreatorFollow[]
  reelLikes        ReelLike[]
  reelComments     ReelComment[]
  reelCommentLikes ReelCommentLike[]
  reelShares       ReelShare[]
  reelViews        ReelView[]
  reelReports      ReelReport[]

  auditLogs  AuditLog[] @relation("AuditActor")
  bans       Ban[]      @relation("BannedUser")
  bansIssued Ban[]      @relation("BanActor")

  @@index([roleId])
  @@index([isBanned])
  @@index([createdAt])
}

// Standard roles seeded as system rows: user, moderator, admin, super_admin.
model Role {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(50)
  name        String
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted from admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

// Permission slugs follow "<resource>.<action>", e.g. "book.publish",
// "verse.write", "user.ban", "role.manage".
model Permission {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(100)
  name        String
  description String?
  group       String  @db.VarChar(50) // "content" | "users" | "system" — for grouping the admin UI

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([group])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Device {
  id String @id @default(cuid())

  deviceId    String  @unique // client-generated stable id
  platform    String  @db.VarChar(20) // "ios" | "android" | "web"
  deviceModel String?
  osVersion   String?
  appVersion  String?

  fcmToken String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  isBanned     Boolean   @default(false)
  bannedReason String?
  bannedAt     DateTime?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  topicSubscriptions FcmSubscription[]
  bans               Ban[]
  pushEvents         PushEvent[]

  @@index([userId])
  @@index([isBanned])
}

// Refresh tokens live a year and are replaced on every use. Only the hash is
// stored; `rotatedAt` marks the row as spent so replay can be detected.
model RefreshToken {
  id String @id @default(cuid())

  tokenHash String  @unique
  userId    String
  deviceId  String?

  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// Content
// ============================================================================

// A Book is any complete work — a full scripture like Srimad Bhagavatam, or a
// single aarti. `type` decides the shape: SCRIPTURE uses chapters (and cantos
// for SB), everything else hangs verses straight off the book.
model Book {
  id String @id @default(cuid())

  // First segment of every verseId beneath this book. 1=BG, 2=SB.
  // Already baked into the scraped S3 content — do not renumber.
  bookNumber Int         @unique
  slug       String      @unique
  type       ContentType

  title           String
  titleI18n       Json? // { "hi": "…", "mr": "…" } — falls back to `title`
  description     String? @db.Text
  descriptionI18n Json?

  sourceLanguage String  @default("sa") @db.VarChar(10)
  sampradaya     String  @default("vaishnav") @db.VarChar(50)
  deityId        String? // stotras and aartis are usually addressed to one deity

  coverImagePath String?
  audioPath      String? // full recitation, for short works sung end to end

  // The S3 folder that holds one recording per verse, laid out beneath it as
  // <parent>/[<canto>/][<chapter>/]<verse>.mp3 — utils/verse-audio.js builds the key.
  // A verse's own Verse.audioPath wins when set; null means the book has no
  // per-verse recitations. Set once for a book and every verse in it is covered.
  recitationParent String?

  totalCantos   Int @default(0)
  totalChapters Int @default(0)
  totalVerses   Int @default(0)

  tags String[] @default([]) // deity and theme tags, e.g. ["krishna", "bhakti"]

  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)

  // The version of the book's text. It goes up BY ITSELF — database triggers
  // (migration 20261025000000_book_content_version), not code a writer has to
  // remember to call — whenever a verse, a translation, a chapter, a canto, a
  // translator's name or this row's own exported fields change, however it
  // happened: an import script, the admin panel, psql.
  contentVersion   Int       @default(1)
  contentChangedAt DateTime? // when it last went up, UTC; the export waits for writes to go quiet
  // The contentVersion the files on S3 were built from (services/book-cache.js).
  // Behind contentVersion = the export owes this book a run. The app is told this
  // number, because it is what the files it can download actually are.
  exportedVersion  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deity Deity? @relation(fields: [deityId], references: [id], onDelete: SetNull)

  cantos          Canto[]
  chapters        Chapter[]
  verses          Verse[]
  stories         Story[]
  translators     BookTranslator[]
  favorites       Favorite[]
  readingProgress ReadingProgress[]
  cacheUnits      BookCacheUnit[]

  @@index([type])
  @@index([sampradaya])
  @@index([deityId])
  @@index([isPublished])
  @@index([displayOrder])
}

// Only Srimad Bhagavatam uses cantos (12 of them). BG has none.
model Canto {
  id String @id @default(cuid())

  bookId String
  number Int

  title       String
  titleI18n   Json?
  summary     String? @db.Text
  summaryI18n Json?

  totalChapters Int @default(0)
  totalVerses   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([bookId, number])
  @@index([bookId])
}

model Chapter {
  id String @id @default(cuid())

  bookId      String
  cantoId     String? // null for BG
  cantoNumber Int? // denormalised so chapter lists don't need the canto join
  number      Int

  title       String
  titleI18n   Json?
  summary     String? @db.Text
  summaryI18n Json?

  totalVerses Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  canto      Canto?      @relation(fields: [cantoId], references: [id], onDelete: Cascade)
  verses     Verse[]
  storyParts StoryPart[]

  @@unique([bookId, cantoNumber, number])
  @@index([bookId])
  @@index([cantoId])
}

// One exported file of the weekly book cache (services/book-cache.js): a chapter
// of the Gita, a canto of the Bhagavatam. This table mirrors
// books/caches/manifest.json — the app learns what to download from the
// manifest endpoint, which reads here, so it costs no S3 call.
//
// `hash` is the SHA-256 of the unit's canonical JSON; `version` goes up by one
// each time the hash changes. A run that finds the same hash touches nothing.
model BookCacheUnit {
  id String @id @default(cuid())

  bookId     String
  unitType   String @db.VarChar(10) // "chapter" | "canto"
  unitId     String // Chapter.id or Canto.id
  unitNumber Int

  hash            String @db.VarChar(64)
  version         Int    @default(1)
  sizeBytes       Int // uncompressed
  compressedBytes Int
  verseCount      Int    @default(0)
  schemaVersion   Int
  s3Key           String

  // Newest updatedAt among the rows the unit was built from.
  contentUpdatedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, unitType, unitId])
  @@index([bookId])
}

// The canonical source text, translation-neutral. Renderings by particular
// translators live in VerseTranslation.
model Verse {
  id String @id @default(cuid())

  // Human-readable universal key, dot-separated, matching the scraped content:
  //   BG    "1.{chapter}.{verse}"            → "1.2.47"
  //   SB    "2.{canto}.{chapter}.{verse}"    → "2.10.1.5"
  //   short "{bookNumber}.{verse}"           → "7.12"
  // This is the uniqueness guarantee for a verse — the positional columns below
  // are for querying and ordering, and are nullable for short works.
  verseId String @unique

  bookId        String
  bookNumber    Int // denormalised from Book, keeps verseId parsing joinless
  cantoNumber   Int? // null unless the book has cantos
  chapterId     String? // null for short works
  chapterNumber Int?

  verseNumber    Int
  verseNumberEnd Int? // compound verses: 13-14 → verseNumber 13, verseNumberEnd 14

  type VerseType @default(SHLOKA)

  sanskrit        String? @db.Text
  transliteration String? @db.Text
  wordMeanings    Json    @default("[]") // [{ word, meaning }] — language-neutral

  audioPath String?
  tags      String[] @default([])

  // Curated pool for "Sloka for You". Only Bhagavad Gita and Srimad Bhagavatam
  // verses (bookNumber 1 and 2) are ever eligible — short works are never used
  // as a daily sloka — and within those, a verse is opted in deliberately.
  isSlokaEligible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book         Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter      Chapter?           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  translations VerseTranslation[]
  explanations VerseExplanation[]
  dailySlokas  DailySloka[]
  userSlokas   UserDailySloka[]
  issueReports UserIssue[]
  issueLinks   VerseIssue[]
  narrations   Narration[]
  favorites    Favorite[]
  readingMarks ReadingProgress[]
  notes        VerseNote[]
  highlights   VerseHighlight[]
  linksFrom    VerseLink[]        @relation("SourceVerse")
  linksTo      VerseLink[]        @relation("TargetVerse")
  reels        Reel[]

  @@index([bookId])
  @@index([chapterId])
  @@index([bookNumber])
  @@index([isSlokaEligible])
  @@index([bookId, cantoNumber, chapterNumber, verseNumber])
}

// An acharya, saint or scholar whose rendering we carry.
// Devotional commentators only — no academic or non-devotee commentary.
model Translator {
  id String @id @default(cuid())

  slug       String  @unique @db.VarChar(100) // "prabhupada", "ramanujacharya"
  name       String
  nameI18n   Json?
  bio        String? @db.Text
  imagePath  String?
  sampradaya String  @default("vaishnav") @db.VarChar(50)

  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookLinks    BookTranslator[]
  translations VerseTranslation[]

  @@index([sampradaya])
  @@index([isPublished])
}

model BookTranslator {
  bookId       String
  translatorId String

  seriesName    String? // e.g. "Bhagavad-gita As It Is"
  publishedYear Int?
  isDefault     Boolean @default(false) // the translation shown unless the user picks another

  book       Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  translator Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@id([bookId, translatorId])
  @@index([translatorId])
}

// One translator's rendering of one verse in one language.
model VerseTranslation {
  id String @id @default(cuid())

  verseId      String
  translatorId String
  languageCode String @db.VarChar(10)

  type TranslationType @default(TRANSLATION)

  meaning String  @db.Text
  purport String? @db.Text

  // The verse in this row's own script, and its word-by-word list in this row's
  // language. Verse.transliteration / Verse.wordMeanings are language-neutral (Roman
  // text, English meanings), so a Hindi or Tamil rendering cannot live there without
  // overwriting them. Set by the Claude translation import (services/translation-import.js);
  // null on every row that came from a book import.
  transliteration String? @db.Text
  wordMeanings    Json? // [{ word, meaning }]

  // Who made the text and which TRANSLATION_VERSION run it came from — 'claude' and
  // e.g. '1.0-12-10-26' for an imported Claude translation, null for a human's.
  translatedBy String? @db.VarChar(20)
  version      String? @db.VarChar(40)

  // Where this came from in the translator's own work — e.g. Dnyaneshwari
  // ovis "141-143" mapped onto a single BG verse.
  sourceRef String? @db.VarChar(50)

  audioPath String?

  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verse      Verse      @relation(fields: [verseId], references: [id], onDelete: Cascade)
  translator Translator @relation(fields: [translatorId], references: [id], onDelete: Cascade)

  @@unique([verseId, translatorId, languageCode, type])
  @@index([verseId, languageCode])
  @@index([translatorId])
  @@index([isPublished])
}

// A short editorial or generated explanation of a verse, written once per
// language and reused by every user who is shown that verse.
//
// Deliberately NOT stored in VerseTranslation: that table holds acharya
// commentary, and app-written or AI text must never be able to surface as if an
// acharya had said it.
model VerseExplanation {
  id String @id @default(cuid())

  verseId      String
  languageCode String @db.VarChar(10)

  text String @db.Text

  source      SlokaSource @default(AI)
  isPublished Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([verseId, languageCode])
  @@index([isPublished])
}

// A saint's telling of the story or teaching around a verse — attributed,
// usually with audio. Distinct from a translator's purport: this is narrative,
// not commentary on the text.
model Narration {
  id String @id @default(cuid())

  verseId String
  guruId  String? // who it is attributed to

  languageCode String  @db.VarChar(10)
  title        String?
  text         String? @db.Text

  audioPath  String? // S3 object key
  durationMs Int?

  sourceNote String? // where it was recorded or published

  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  guru  Guru? @relation(fields: [guruId], references: [id], onDelete: SetNull)

  @@index([verseId, languageCode])
  @@index([guruId])
  @@index([isPublished])
}

// Connections between verses across the Gita and the Bhagavatam. Directional:
// the pair (A→B) and (B→A) are separate rows, because "expands on" does not
// read the same both ways.
model VerseLink {
  id String @id @default(cuid())

  sourceVerseId String
  targetVerseId String

  relation VerseLinkRelation @default(SAME_CONCEPT)
  note     String?

  createdAt DateTime @default(now())

  sourceVerse Verse @relation("SourceVerse", fields: [sourceVerseId], references: [id], onDelete: Cascade)
  targetVerse Verse @relation("TargetVerse", fields: [targetVerseId], references: [id], onDelete: Cascade)

  @@unique([sourceVerseId, targetVerseId, relation])
  @@index([sourceVerseId])
  @@index([targetVerseId])
}

// ============================================================================
// Stories — devotee pastimes, teaching cycles and stotras curated for reading
// ============================================================================
//
// The text itself is not duplicated here — it already exists as Book/Canto/
// Chapter/Verse, scraped once from source. A Story curates and introduces a
// range of that text as one readable unit: a devotee's life (Prahlada, Dhruva,
// Ajamila, Gajendra…), a teaching cycle (Dattatreya's twenty-four gurus, SB
// 11.7-9), or a stotra (Narayana Kavacha, SB 6.8). Deliberately not the `Guru`
// model above — Guru is the Vaishnav parampara a mantra or practice comes
// through (Prabhupada, Ramanujacharya…); the twenty-four gurus are earth,
// air, a pigeon, a prostitute — teachers by example, not lineage.

// One curated story, spanning a range of an existing book.
model Story {
  id String @id @default(cuid())

  slug String    @unique @db.VarChar(100) // "dattatreya-24-gurus", "gajendra-moksha"
  kind StoryKind

  title           String
  titleI18n       Json?
  description     String? @db.Text // what the story is and why it matters, shown before reading
  descriptionI18n Json?

  bookId      String
  cantoNumber Int? // denormalised, same reasoning as Chapter.cantoNumber

  imagePath String? // S3 object key
  audioPath String? // full narration, when one exists

  tags String[] @default([])

  displayOrder Int     @default(0)
  isPublished  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book      Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parts     StoryPart[]
  favorites Favorite[]

  @@index([bookId])
  @@index([kind])
  @@index([isPublished])
}

// One numbered unit within a Story — one of the twenty-four gurus, one beat
// of a devotee's life, one protective assignment in a kavacha. Points at the
// chapter and verse range it is drawn from so the reader can jump to the
// source text; a range rather than a single verseId because a unit is rarely
// exactly one verse (the honeybee's lesson alone spans four, SB 11.8.9-12).
model StoryPart {
  id String @id @default(cuid())

  storyId String
  number  Int // 1-based position within the story — the guru's place in the list, etc.

  title           String // e.g. "The Earth", "The Honeybee", "Kesava — the head"
  titleI18n       Json?
  description     String? @db.Text // the teaching itself, in prose
  descriptionI18n Json?

  chapterId        String
  verseNumberStart Int
  verseNumberEnd   Int? // null means a single verse, same convention as Verse.verseNumberEnd

  imagePath String?
  audioPath String?

  // Opted in to the daily rotation (DailyStoryPart) — "today's guru" and
  // whatever else earns a daily slot later. Mirrors Verse.isSlokaEligible:
  // being part of a story doesn't make a unit fit to stand alone each morning.
  isDailyEligible Boolean @default(false)
  isPublished     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  story      Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter    Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  issueLinks StoryPartIssue[]
  dailyPicks DailyStoryPart[]

  @@unique([storyId, number])
  @@index([chapterId])
  @@index([isDailyEligible])
  @@index([isPublished])
}

// Which vikaras (or other Issues) a story part speaks to — same shape as
// VerseIssue, so a guru's lesson is just another kind of content the
// personalisation picker can draw from once a user reports a struggle.
model StoryPartIssue {
  storyPartId String
  issueId     String

  weight Int @default(0)

  storyPart StoryPart @relation(fields: [storyPartId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([storyPartId, issueId])
  @@index([issueId, weight])
}

// The one story part surfaced globally for a given date — "today's guru", and
// whatever else gets a daily slot later. Same shape as DailySloka.
model DailyStoryPart {
  id String @id @default(cuid())

  date        DateTime @unique @db.Date
  storyPartId String

  isPublished Boolean   @default(false)
  sentAt      DateTime? // set when the cron job has pushed it out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storyPart StoryPart @relation(fields: [storyPartId], references: [id], onDelete: Cascade)

  @@index([storyPartId])
}

// ============================================================================
// Issues — what a user is struggling with, and which slokas answer it
// ============================================================================

// Seeded with the six vikaras (kama, krodha, lobha, moha, mada, matsarya) and
// the practice difficulties a user can report — missing their chanting time,
// falling short of their round target.
model Issue {
  id String @id @default(cuid())

  slug        String        @unique @db.VarChar(100) // "krodha", "missed-rounds"
  name        String
  nameI18n    Json?
  description String?       @db.Text
  category    IssueCategory

  imagePath String? // S3 object key

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verseLinks     VerseIssue[]
  storyPartLinks StoryPartIssue[]
  reports        UserIssue[]
  userSlokas     UserDailySloka[]

  @@index([category])
  @@index([isPublished])
}

// Which slokas speak to which struggle. This is the table the personalisation
// reads: a user reports krodha, and the picker draws from verses linked here.
// `weight` breaks ties so the most directly relevant verse wins.
model VerseIssue {
  verseId String
  issueId String

  weight Int @default(0)

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([verseId, issueId])
  @@index([issueId, weight])
}

// A user saying what they are struggling with today. Kept as an append-only log
// rather than a current-mood column, so the productivity report can show which
// vikara recurs and whether it eases over time.
model UserIssue {
  id String @id @default(cuid())

  userId       String
  issueId      String
  sadhanaDayId String? // the day it was reported against, when there is one

  intensity Int? // 1–5, how strongly it is felt
  note      String? @db.Text

  reportedAt DateTime @default(now())

  // The user's own local date this was reported on — same "UTC midnight of
  // the local date" convention as SadhanaDay.date and UserDailySloka.date.
  // What lets the dashboard ask "which vikaras has this person already told
  // us about today" as a plain equality lookup instead of timezone-aware
  // range math over `reportedAt`. Nullable only because rows written before
  // this column existed have nothing to backfill it with.
  date DateTime? @db.Date

  // The sloka this report was answered with, from the mood endpoint — not set
  // by the free-standing `/issues/report`. `UserDailySloka` keeps only one row
  // per user per date, so a second vikara reported the same day overwrites the
  // first there; this is what still lets that first one be reopened and read
  // again, since the report itself is append-only and never overwritten.
  verseId String?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  day   SadhanaDay? @relation(fields: [sadhanaDayId], references: [id], onDelete: SetNull)
  verse Verse?      @relation(fields: [verseId], references: [id], onDelete: SetNull)

  @@index([userId, reportedAt])
  @@index([userId, date])
  @@index([issueId])
  @@index([sadhanaDayId])
  @@index([verseId])
}

// What the system has learned about one user, rebuilt weekly by a cron job from
// their own activity: issues reported, slokas opened, chanting consistency.
//
// Entirely derived — every field can be recomputed from UserIssue, SadhanaDay
// and UserDailySloka. Nothing here is a source of truth, so it is safe to wipe
// and regenerate when the scoring changes.
model UserPreferenceProfile {
  id String @id @default(cuid())

  userId String @unique

  // Weighted scores rather than a single winner, so the picker can vary the
  // sloka instead of returning the same theme every day.
  //   issueScores { "krodha": 0.8, "moha": 0.3 }
  //   topicScores { "bhakti": 0.6, "karma": 0.2 }
  issueScores Json @default("{}")
  topicScores Json @default("{}")

  preferredBookNumber   Int?
  preferredTranslatorId String?

  bestDeliveryHour Int? // 0–23 in the user's own timezone, from when they actually open
  avgRoundsPerDay  Float?
  chantConsistency Float? // 0–1 across the window

  windowStart DateTime @db.Date
  windowEnd   DateTime @db.Date
  computedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([computedAt])
}

// ============================================================================
// Sloka for You — the daily sloka, global and personalised
// ============================================================================

// The global sloka: one per date, the same for everyone.
model DailySloka {
  id String @id @default(cuid())

  date    DateTime @unique @db.Date
  verseId String

  source    SlokaSource @default(MANUAL)
  imagePath String? // generated artwork, S3 object key

  isPublished Boolean   @default(false)
  sentAt      DateTime? // set when the cron job has pushed it out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@index([verseId])
}

// One user's own sloka for one date, chosen for them rather than shared.
//
// A row is written by the nightly cron before it is delivered, so `notifiedAt`
// and `seenAt` distinguish "picked" from "pushed" from "actually read" — the
// three states a delivery job needs to avoid double-sending.
model UserDailySloka {
  id String @id @default(cuid())

  userId  String
  date    DateTime @db.Date
  verseId String

  source SlokaSource @default(RULE)

  // The struggle this sloka was chosen to answer, and a human-readable note the
  // app can show as "because you mentioned krodha". Null when the pick was not
  // issue-driven — a fallback or an admin override.
  issueId String?
  reason  String?

  notifiedAt DateTime?
  seenAt     DateTime?

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse Verse  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  issue Issue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, notifiedAt]) // the cron sweeps one date's undelivered batch
  @@index([verseId])
}

// ============================================================================
// User engagement — favourites, reading progress, notifications
// ============================================================================

// Bookmarks. Exactly one target column is set per row; which one is enforced in
// the controller. Real foreign keys rather than a generic targetType/targetId
// pair, so deleting a verse takes its bookmarks with it.
model Favorite {
  id String @id @default(cuid())

  userId   String
  verseId  String?
  mantraId String?
  bookId   String?
  reelId   String?
  storyId  String?

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse  Verse?  @relation(fields: [verseId], references: [id], onDelete: Cascade)
  mantra Mantra? @relation(fields: [mantraId], references: [id], onDelete: Cascade)
  book   Book?   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reel   Reel?   @relation(fields: [reelId], references: [id], onDelete: Cascade)
  story  Story?  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, verseId])
  @@unique([userId, mantraId])
  @@unique([userId, bookId])
  @@unique([userId, reelId])
  @@unique([userId, storyId])
  @@index([userId, createdAt])
}

// Where a user left off in a book — one row per user per book, overwritten as
// they read. Feeds "continue reading" and the weekly preference learning.
model ReadingProgress {
  id String @id @default(cuid())

  userId String
  bookId String

  // Last verse actually reached. Denormalised numbers so the reading list can
  // render "Canto 3, Chapter 12" without loading the verse.
  verseId       String?
  cantoNumber   Int?
  chapterNumber Int?
  verseNumber   Int?

  versesRead Int      @default(0)
  lastReadAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book  Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  verse Verse? @relation(fields: [verseId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([userId, lastReadAt])
}

// A reader's own words against a verse. Deliberately separate from
// VerseExplanation — that is app-written prose shown to every reader; this is
// personal and private, one row per thought, not one per verse. Named
// VerseNote (not just "Note") so it is never confused with the Notes tab,
// which is an unrelated feature — daily tasks and timetable, not verses.
model VerseNote {
  id String @id @default(cuid())

  userId  String
  verseId String

  text String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@index([userId, verseId])
}

// A verse a reader has marked while reading. Distinct from Favorite: a
// favourite is something saved to a personal collection surfaced elsewhere in
// the app; a highlight is an emphasis inline in the text being read, and a
// reader may want one without the other. Whole-verse granularity — no
// sub-string range, the same way a favourite has none.
model VerseHighlight {
  id String @id @default(cuid())

  userId  String
  verseId String

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([userId, verseId])
  @@index([userId])
}

// In-app notification history. Written whether or not a push went out, so the
// user sees the same list on a device that had notifications disabled.
model Notification {
  id String @id @default(cuid())

  userId String
  type   NotificationType

  title String
  body  String @db.Text
  data  Json? // deeplink target and any payload the app needs

  sentAt DateTime?
  readAt DateTime?

  // The send this belongs to — see PushCampaign.
  campaignId String?

  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign PushCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([campaignId])
}

// One push message as the admin panel sees it: "the sloka of 21 October", "Ekadashi
// tomorrow", a broadcast someone typed. A campaign is shared by everyone it went to —
// a million people receiving one festival push is one row here, not a million.
//
// `key` is how a sender names its campaign so repeated sends land on the same row
// (services/notify.js falls back to type + day). The counters are what the server
// knows — FCM accepted the message for this many devices. What the phones then say
// happened (delivered, opened, read) is PushEvent.
model PushCampaign {
  id String @id @default(cuid())

  key    String           @unique @db.VarChar(200)
  type   NotificationType
  source String           @default("system") @db.VarChar(40) // system | topic | audience | user

  title String
  body  String @db.Text

  targetedUsers Int @default(0) // people the send was addressed to
  sentDevices   Int @default(0) // devices FCM accepted it for (topic sends: subscribers)
  failedDevices Int @default(0)

  createdAt DateTime @default(now())

  events        PushEvent[]
  notifications Notification[]

  @@index([createdAt])
}

enum PushEventType {
  DELIVERED // reached the app (open at the time, or its background handler ran)
  OPENED // the notification was tapped
  ENGAGED // the app reports how long the reader stayed after opening it
}

// What a phone reports about a push. One row per device per kind, so a retried
// report or a second tap never counts twice; ENGAGED keeps the longest stay.
model PushEvent {
  id String @id @default(cuid())

  campaignId String
  deviceId   String
  userId     String?

  event      PushEventType
  durationMs Int? // ENGAGED only
  screen     String? @db.VarChar(200) // where the tap took them, ENGAGED only

  occurredAt DateTime // the phone's clock, clamped to the server's
  createdAt  DateTime @default(now())

  campaign PushCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  device   Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, deviceId, event])
  @@index([campaignId, event])
}

// FCM broadcast topics. Sending to a topic is one call regardless of audience
// size, so anything going to everyone goes here rather than looping devices.
model FcmTopic {
  id String @id @default(cuid())

  key         String  @unique @db.VarChar(100) // "sloka-of-day", "announcements"
  name        String
  description String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  subscriptions FcmSubscription[]
}

model FcmSubscription {
  id String @id @default(cuid())

  deviceId String
  topicId  String

  subscribedAt DateTime @default(now())

  device Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  topic  FcmTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([deviceId, topicId])
  @@index([topicId])
}

// ============================================================================
// Money — subscriptions and donations
// ============================================================================

// A tier of benefit. `free` is the baseline every user is on with no
// subscription — it is a real row so that what a free user gets is edited in
// the same place as what a paid user gets, and the app can show them side by
// side. Paid plans sit above it by `tier`.
//
// What a plan costs is not here: that differs by store and by billing period,
// so it lives on PlanPrice. What a plan unlocks is not here either — see
// Feature and PlanFeature.
model SubscriptionPlan {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(50) // "free", "premium"
  name        String
  description String? @db.Text

  // Rank, 0 = the free baseline. When a user holds several entitlements (a
  // subscription and a donation, say) the highest tier wins.
  tier Int @default(0)

  // Exactly one plan is the free baseline. Never sold, so it has no prices.
  isFree Boolean @default(false)

  // Donating any amount earns permanent access to this plan — the highest tier
  // flagged here. See services/entitlement.js.
  grantedToDonors Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices        PlanPrice[]
  features      PlanFeature[]
  subscriptions Subscription[]
  aiConfig      AiPlanConfig?
  grants        EntitlementGrant[]

  @@index([isActive, tier])
}

// One way of buying a plan: a store product with a price and a billing period.
//
// A plan has one row per (provider, period). Adding a store means a new
// PaymentProvider value, a file in services/payments/ and rows here — the plan
// itself does not change. `productId` is what the store knows the product by
// (Play subscription id, App Store product id, Razorpay plan id), which is why
// it is data and not a constant in the app.
//
// `priceMinor` is what the panel shows and what the app falls back on; the
// store's own localised price is what the user is actually charged, and the
// amount really paid is on the Payment row.
model PlanPrice {
  id String @id @default(cuid())

  planId String

  provider  PaymentProvider
  productId String

  priceMinor Int // smallest currency unit — never a float
  currency   String @db.VarChar(3)
  periodDays Int    @default(30)

  // Free trial offered with this product. 0 = none. The store enforces the
  // trial; this is so the app can say "7 days free" before opening the sheet.
  trialDays Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan          SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([provider, productId])
  @@index([planId, isActive])
}

// What the product can do, named once. `key` is what code asks about —
// `entitlement.can(userId, 'downloads.offline')` — so it is permanent; the name
// and description are free to change.
//
// Features are added as the app grows them, with nothing deployed: a row here
// and values on the plans. FLAG is on/off; LIMIT is a number (a daily quota, a
// cap), where a null limit means unlimited.
model Feature {
  id String @id @default(cuid())

  key         String      @unique @db.VarChar(80) // "ads.removed", "downloads.offline"
  name        String
  description String?     @db.Text
  kind        FeatureKind @default(FLAG)
  unit        String?     @db.VarChar(40) // "per day", "items" — display only, for LIMIT

  // What a plan with no PlanFeature row gets. True by default: the app is free,
  // and a feature a plan was never configured for should not silently lock
  // people out of it.
  defaultEnabled Boolean @default(true)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  @@index([isActive, sortOrder])
}

// A feature's value on one plan.
model PlanFeature {
  id String @id @default(cuid())

  planId    String
  featureId String

  enabled Boolean @default(true)
  // LIMIT features only; null with `enabled` true means unlimited.
  limit   Int?

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}

model Subscription {
  id String @id @default(cuid())

  userId String
  planId String

  // The store product it was bought through. Null for rows that predate
  // PlanPrice, and when the product has since been deleted.
  priceId String?

  provider   PaymentProvider
  externalId String? // the provider's own subscription id

  status SubscriptionStatus @default(ACTIVE)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  autoRenew        Boolean   @default(true)

  // Last store event applied, for support ("why is this cancelled?").
  lastEvent   String?
  lastEventAt DateTime?
  // Set while the store is retrying a failed renewal (grace or on hold).
  billingIssueAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  price    PlanPrice?       @relation(fields: [priceId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([provider, externalId])
  @@index([userId, status])
  @@index([currentPeriodEnd])
}

// Every money event, subscription renewals and donations alike. One ledger
// because both arrive as provider webhooks, both need the same reconciliation,
// and separating them would mean maintaining two of everything.
//
// `(provider, externalId)` is unique: provider webhooks retry, and without that
// constraint a retry credits the user twice.
model Payment {
  id String @id @default(cuid())

  userId         String
  subscriptionId String? // set when purpose is SUBSCRIPTION

  provider   PaymentProvider
  purpose    PaymentPurpose
  externalId String // provider's transaction/order id

  amountMinor Int // smallest currency unit
  currency    String @db.VarChar(3)

  status PaymentStatus @default(PENDING)

  // Donation-only: what the donor wanted to say, and whether to name them.
  message     String? @db.Text
  isAnonymous Boolean @default(false)

  paidAt     DateTime?
  refundedAt DateTime?

  // ── Revenue (see services/payments/money.js) ──────────────────────────────
  // `amountMinor` + `currency` above are what the payer was charged, in the
  // payer's own currency (tax included where the store includes it). Everything
  // below is derived once, when the payment is recorded, and never re-derived,
  // so a month's revenue does not change when exchange rates move later.
  //
  // A free trial is a real row with amountMinor 0 and isTrial true, so the
  // subscriber's history is complete and the revenue is zero.
  isTrial Boolean @default(false)

  // Original currency: what the platform kept and what reaches the bank.
  commissionMinor Int?
  netMinor        Int?

  // INR (paise) — the figures the admin panel and the finance section read.
  // gross = what the payer paid, commission = the platform's cut, net = what we
  // earn. Null while the exchange rate could not be fetched (the nightly job
  // fills them in); 0 for a free trial.
  grossInrMinor      Int?
  commissionInrMinor Int?
  netInrMinor        Int?

  // How the commission was found: STORE (the store reported it), RATE (our
  // configured rate x the price), NONE (a trial).
  commissionSource String?
  commissionRate   Decimal? @db.Decimal(6, 4)

  // INR per one unit of `currency`, where it came from and the day it is for.
  fxRate   Decimal?  @db.Decimal(18, 8)
  fxSource String?
  fxDate   DateTime? @db.Date

  // The provider's raw webhook body, kept for disputes and for replaying a
  // payment that failed to process on our side.
  providerPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([userId, purpose])
  @@index([status, createdAt])
  @@index([purpose, paidAt])
  @@index([grossInrMinor, paidAt])
}

// One day's exchange rate into INR, so each rate is fetched once and every
// payment of that day and currency is converted with the same number.
model FxRate {
  id String @id @default(cuid())

  currency   String   @db.VarChar(3)
  date       DateTime @db.Date
  inrPerUnit Decimal  @db.Decimal(18, 8)
  source     String // FRANKFURTER, OPEN_ER_API, MANUAL

  createdAt DateTime @default(now())

  @@unique([currency, date])
}

// ============================================================================
// System — settings and AI usage
// ============================================================================

// Runtime configuration an admin can change without a deploy: active AI
// provider, model names, feature flags. Anything static belongs in config/
// files instead — this table is only for what must change at runtime.
//
// Secrets are stored encrypted and never returned to any client.
model AppSetting {
  key String @id @db.VarChar(100) // "ai.provider", "ai.model.text", "sloka.cron.hour"

  value       String  @db.Text
  isSecret    Boolean @default(false)
  description String?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ============================================================================
// Finance — the owner's books (super admin only)
// ============================================================================

enum FinanceDirection {
  CREDIT // money in that is not a store payment: a grant, a sponsor, a refund from a vendor
  DEBIT // money out: advertising, salary, a purchase
}

// One line the super admin typed in. Store revenue and AI spend are not here — they are
// read from Payment and AiUsageLog, so the same rupee is never counted twice.
model FinanceEntry {
  id String @id @default(cuid())

  direction FinanceDirection
  // advertising · purchase · salary · tools · other (validated in controllers/admin/finance.js)
  category  String          @db.VarChar(30)
  // Paise, always positive; `direction` says which way it went.
  amountInr Int

  // The day it happened in India (UTC midnight of the IST date); the month it belongs to follows from it.
  occurredOn DateTime @db.Date
  note       String?  @db.VarChar(500)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([occurredOn])
}

// One row per calendar month (IST), made when the super admin first confirms it.
model FinanceMonth {
  month String @id @db.VarChar(7) // "2026-09"

  // The USD to INR rate the month's AI spend is converted at. Fixed when the month is confirmed so a
  // closed month never moves; an open month uses the current rate (setting finance.usd_inr_rate).
  usdInrRate Decimal? @db.Decimal(10, 4)

  // The super admin has entered (or ruled out) this month's costs. Stops the month-end reminder.
  costsConfirmedAt DateTime?
  costsConfirmedById String?

  // The last reminder sent for this month, so one day sends one.
  lastRemindedOn DateTime? @db.Date

  updatedAt DateTime @updatedAt
}

// One row per AI call. Exists so spend is visible per operation — without it
// there is no way to tell which job is costing money or when a prompt change
// made it worse.
model AiUsageLog {
  id String @id @default(cuid())

  provider AiProvider
  model    String     @db.VarChar(100)

  // What the call was for: "verse.issue-map", "verse.explanation", "sloka.image".
  operation String @db.VarChar(50)

  // What it was generating for, when it targets one row.
  targetType String? @db.VarChar(50)
  targetId   String?

  // Who the call was made for, when it was made for a person (chat, summaries).
  userId String?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  // Whole millionths of a USD. An integer because floating point silently
  // drifts once these are summed over hundreds of thousands of calls.
  costMicros Int @default(0)

  succeeded    Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([operation, createdAt])
  @@index([provider, createdAt])
  @@index([targetType, targetId])
}

// Every admin action that changes data. RBAC without this only says who *could*
// have done something; this says who did.
model AuditLog {
  id String @id @default(cuid())

  actorId String? // null if the actor was deleted — the record must outlive them
  action  String  @db.VarChar(100) // "book.publish", "user.ban", "role.update"

  entityType String  @db.VarChar(50)
  entityId   String?

  // Only the fields that changed, not whole rows — otherwise this table grows
  // faster than the data it describes.
  before Json?
  after  Json?

  ipAddress String? @db.VarChar(45)
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// Ban records, kept as history rather than only as flags. The flags on User and
// Device stay as the fast check; this table answers who banned, why, and
// whether it was lifted.
model Ban {
  id String @id @default(cuid())

  userId   String?
  deviceId String?
  actorId  String? // the admin who issued it

  reason   String   @db.Text
  bannedAt DateTime @default(now())

  liftedAt   DateTime?
  liftedById String?
  liftReason String?   @db.Text

  user   User?   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actor  User?   @relation("BanActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([bannedAt])
}

// ============================================================================
// Reference data — seeded, then managed from admin
// ============================================================================

// Which languages the app offers. Users pick three (app, mantra, reading) and
// this is the list they pick from, so adding a language is a data change.
model Language {
  id String @id @default(cuid())

  code        String  @unique @db.VarChar(10) // "en", "hi", "mr", "sa"
  nativeName  String // "हिन्दी"
  englishName String // "Hindi"
  isRtl       Boolean @default(false)

  // Whether it can be chosen for each of the three settings — Sanskrit is a
  // valid mantra language but not a sensible app language.
  isAppLanguage     Boolean @default(true)
  isMantraLanguage  Boolean @default(true)
  isReadingLanguage Boolean @default(true)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Deities content can be attributed to or filtered by. Seeded with the Vaishnav
// set (Krishna, Vishnu, Rama, Narasimha, Radha …) and extended from admin.
model Deity {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(100)
  name        String
  nameI18n    Json? // { "hi": "…", "mr": "…" } — falls back to `name`
  description String? @db.Text

  imagePath     String? // S3 object key — the picture in lists and in the middle of the chant counter
  fullImagePath String? // S3 object key — a 9:16 picture of the deity that fills the chant screen

  sampradaya   String  @default("vaishnav") @db.VarChar(50)
  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantras Mantra[]
  books   Book[]
  reels   Reel[]

  @@index([sampradaya])
  @@index([isPublished])
}

// Gurus and acharyas a mantra or practice comes through. Seeded with the
// Vaishnav parampara and extended from admin.
//
// Overlaps with Translator by design: the same person can appear in both when
// they are both a guru and the author of a translation. Kept separate because
// the two are used for different things — Translator carries a rendering of a
// text, Guru carries spiritual lineage.
model Guru {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(100)
  name        String
  nameI18n    Json?
  description String? @db.Text

  imagePath String? // S3 object key

  sampradaya   String  @default("vaishnav") @db.VarChar(50)
  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantras    Mantra[]
  narrations Narration[]

  @@index([sampradaya])
  @@index([isPublished])
}

// ============================================================================
// Mantras
// ============================================================================

// A mantra's canonical form. Every language rendering — English included —
// lives in MantraTranslation, so no single language is baked into the base row
// and adding a new one never touches this table.
model Mantra {
  id String @id @default(cuid())

  slug        String  @unique @db.VarChar(100)
  name        String // canonical name, e.g. "Hare Krishna Mahamantra"
  description String? @db.Text

  deityId String? // whom the mantra invokes
  guruId  String? // the guru or acharya this mantra comes through

  // Devanagari source and its Roman transliteration. Kept here as the
  // last-resort fallback when a user's three language choices all miss.
  sanskrit        String  @db.Text
  transliteration String? @db.Text

  category   String   @db.VarChar(50) // "mahamantra" | "beej" | "name" | "gayatri" …
  sampradaya String   @default("vaishnav") @db.VarChar(50)
  tags       String[] @default([])

  // S3 object key, not a URL — the bucket is private and links are presigned at
  // response time, so a stored URL would expire. Required before publishing.
  audioPath String?

  // Roughly how long one recitation takes. Drives the in-app chant pacing and
  // the round-duration estimate, so it must hold even when audio hasn't loaded.
  durationMs Int?

  // One whole mala chanted on a recording — optional. The counter plays it and
  // counts along: the chanting runs from malaAudioStartMs to malaAudioEndMs
  // (the mahamantra recording opens with the Pancha-tattva mantra, which is not
  // a chant), and that span is split evenly into the round's 108 chants. Key,
  // not URL, for the same reason as audioPath. All three are set together or
  // not at all — the admin API refuses a half-filled recording.
  malaAudioPath    String?
  malaAudioStartMs Int?
  malaAudioEndMs   Int?

  // How the mantra may be heard when it is chanted — the spellings the app's
  // on-device speech recogniser is matched against to count a repetition by
  // ear (auto count). Plain Roman letters, one full repetition each: the
  // standard transliteration first, then looser spellings of what an
  // English-trained recogniser tends to write down. A repetition counts when a
  // phrase is matched at least ~50% (stricter for very short mantras), so a
  // fast or slurred chant still counts. Empty means the app falls back to
  // `transliteration`. Set in prisma/seed/chant-phrases.js.
  chantPhrases String[] @default([])

  // The English words the phone's English-only recogniser writes when this mantra is
  // chanted (it turns Sanskrit into the nearest English it knows). Hearing one counts a
  // chant, at most one per durationMs. Empty: the app counts by sound alone.
  chantWords String[] @default([])

  // Mantras are counted two different ways in practice, so both are kept and
  // either may be null: japa mantras in rounds of 108 beads (mahamantra: 16
  // rounds), others in plain repetitions (gayatri: 3, 11 or 108 times).
  standardRounds Int?
  standardCount  Int?

  // The prayer chanted before this mantra, e.g. the Pancha-tattva mantra before the
  // mahamantra. The counter shows it before every round and counts nothing until it
  // has been chanted — see "Opening prayers" in backend/CLAUDE.md. Optional; a prayer
  // is itself a mantra, so it has a standard chanting time and its own renderings.
  prayerMantraId String?

  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deity Deity? @relation(fields: [deityId], references: [id], onDelete: SetNull)
  guru  Guru?  @relation(fields: [guruId], references: [id], onDelete: SetNull)

  // Deleting a prayer leaves the mantras that used it with none.
  prayerMantra Mantra?  @relation("MantraPrayer", fields: [prayerMantraId], references: [id], onDelete: SetNull)
  prayerFor    Mantra[] @relation("MantraPrayer")

  translations     MantraTranslation[]
  chantSessions    ChantSession[]
  favorites        Favorite[]
  reels            Reel[]
  preferredByUsers SadhanaProfile[]    @relation("PreferredMantra")
  legacyFavoriteOf SadhanaProfile[]    @relation("LegacyFavoriteMantra")

  @@index([category])
  @@index([sampradaya])
  @@index([deityId])
  @@index([guruId])
  @@index([prayerMantraId])
  @@index([isPublished])
}

// One language's rendering of a mantra. Carries both the mantra written in that
// script and what it means. Both follow the user's readingLanguage; `text` falls
// to their mantraLanguage, then English, then Sanskrit when that language has no
// row, so a response can combine two different rows of this table.
model MantraTranslation {
  id String @id @default(cuid())

  mantraId     String
  languageCode String @db.VarChar(10) // "sa", "hi", "mr", "en", …

  name        String? // localised name of the mantra
  description String? @db.Text
  text        String  @db.Text // the mantra itself, in this language's script

  meaning String? @db.Text
  purport String? @db.Text

  // This language's own recitation. Falls back to Mantra.audioPath when absent.
  audioPath  String?
  durationMs Int?

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mantra Mantra @relation(fields: [mantraId], references: [id], onDelete: Cascade)

  @@unique([mantraId, languageCode])
  @@index([mantraId, languageCode])
  @@index([isPublished])
}

// ============================================================================
// Sadhana — daily practice, chanting and tasks
// ============================================================================

// Standing preferences used to prefill each new day.
model SadhanaProfile {
  id String @id @default(cuid())

  userId String @unique

  dailyRoundTarget  Int     @default(16)
  reminderTime      String? @db.VarChar(5) // "04:30", local to User.timezone
  preferredMantraId String? // what "Chant now" opens with when nothing more specific was tapped

  // The mantra this person chanted most on the old app, worked out once when their account
  // was carried over. Only a starting point: `favouriteMantra()` (controllers/app/sadhana.js)
  // uses it while there is no chanting here to go by, and the chanting here wins from the
  // first sitting, so a wrong guess corrects itself. Never the user's explicit choice —
  // that is `preferredMantraId`.
  legacyFavoriteMantraId String?

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredMantra      Mantra? @relation("PreferredMantra", fields: [preferredMantraId], references: [id], onDelete: SetNull)
  legacyFavoriteMantra Mantra? @relation("LegacyFavoriteMantra", fields: [legacyFavoriteMantraId], references: [id], onDelete: SetNull)

  @@index([preferredMantraId])
  @@index([legacyFavoriteMantraId])
}

// One row per user per calendar date — the anchor every report is built from.
// The count columns are rollups of the child rows, kept here so a year of
// history can be charted without aggregating sessions and tasks each time.
model SadhanaDay {
  id String @id @default(cuid())

  userId String
  date   DateTime @db.Date // the user's local date, resolved via SadhanaProfile.timezone

  roundTarget     Int @default(0)
  roundsCompleted Int @default(0)

  tasksTotal Int @default(0)
  tasksDone  Int @default(0)

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chantSessions ChantSession[]
  tasks         SadhanaTask[]
  issues        UserIssue[]

  @@unique([userId, date])
  @@index([userId, date])
}

// Either a live in-app japa session or a round count entered after the fact.
// Both land here so totals never have to be assembled from two places.
model ChantSession {
  id String @id @default(cuid())

  userId       String
  sadhanaDayId String
  mantraId     String?

  source ChantSource @default(IN_APP)

  rounds Int @default(0)
  beads  Int @default(0) // beads into the round in progress; 108 completes a round

  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  createdAt DateTime @default(now())

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         SadhanaDay           @relation(fields: [sadhanaDayId], references: [id], onDelete: Cascade)
  mantra      Mantra?              @relation(fields: [mantraId], references: [id], onDelete: SetNull)
  malas       ChantMala[]
  transcripts ChantTapTranscript[]

  @@index([userId, startedAt])
  @@index([sadhanaDayId])
}

// One round of a session — the start, the end and every tap in between.
//
// Taps live inside the row as a JSON array rather than as a row each: a round
// is at most 108 of them, they are only ever read together with their round and
// never queried on their own, and a table with a row per bead would grow by
// thousands a day per active user. Each entry is
// `{ seq, at (epoch ms), gapMs, auto }` — `gapMs` is the time since the tap
// before it, which is what "how long did that chant take" means.
//
// Durable: unlike ChantTapTranscript this is practice history and is kept.
model ChantMala {
  id String @id @default(cuid())

  sessionId String
  userId    String

  index      Int // 1-based within the session
  beads      Int       @default(0) // taps recorded; 108 once the round is complete
  startedAt  DateTime // first tap of the round
  endedAt    DateTime? // last tap of the round
  durationMs Int       @default(0)
  avgGapMs   Int       @default(0)
  complete   Boolean   @default(false)

  taps Json @default("[]")

  updatedAt DateTime @updatedAt

  session ChantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, index])
  @@index([userId, startedAt])
}

// What speech recognition heard for one tap. Deliberately short-lived: it is
// bulky, only useful while someone is still looking at the sitting it came
// from, and `expiresAt` is stamped on write so the nightly prune is one
// indexed delete. Reads also filter on it, so a row is gone to users the
// moment it expires even if the prune has not run yet.
model ChantTapTranscript {
  id String @id @default(cuid())

  sessionId String
  userId    String

  seq        Int // the tap this was heard for, matching ChantMala.taps[].seq
  malaIndex  Int
  text       String  @db.VarChar(500)
  confidence Float?
  locale     String? @db.VarChar(16)

  // Set when the audio itself is kept (S3 key) instead of, or alongside, the
  // on-device text. Unused until audio upload exists.
  audioKey String? @db.VarChar(255)

  heardAt   DateTime
  expiresAt DateTime

  session ChantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([expiresAt])
  @@index([userId, heardAt])
}

// A task on one day's list.
//
// Moving a task to another day does not edit this row. It is marked MOVED and a
// fresh row is created on the target day pointing back through `movedFromId`,
// so each day keeps an honest record of what was actually planned and finished
// — otherwise a repeatedly deferred task would silently rewrite past days.
model SadhanaTask {
  id String @id @default(cuid())

  userId       String
  sadhanaDayId String

  title String
  note  String?

  status       TaskStatus @default(PENDING)
  displayOrder Int        @default(0)
  doneAt       DateTime?

  movedFromId String?      @unique
  movedFrom   SadhanaTask? @relation("TaskMove", fields: [movedFromId], references: [id], onDelete: SetNull)
  movedTo     SadhanaTask? @relation("TaskMove")
  deferCount  Int          @default(0) // times carried forward, copied on each move

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  day  SadhanaDay @relation(fields: [sadhanaDayId], references: [id], onDelete: Cascade)

  @@index([sadhanaDayId])
  @@index([userId, status])
}

// ============================================================================
// Routine — the app's Routine tab: a personal day list of devotion, work, home
// and errands, plus an optional daily routine that repeats.
//
// Separate from SadhanaTask on purpose. That one is a plain checklist attached to
// a SadhanaDay; the routine has categories, a standard time range per item and a
// time it was done at, and its daily items are not rows of any one day.
//
// The phone keeps its own copy and mirrors it here (POST /api/app/routine/sync),
// so these rows are keyed by the id the phone made, per user, and a day is the
// user's own calendar date as `YYYY-MM-DD` — no zone, the way the phone keeps it.
// Times are minutes after midnight. Nothing here is derived from anything else.
// ============================================================================

// Something added for one particular day.
model RoutineTask {
  userId String
  id     String // made by the phone; unique per user only

  day      String @db.VarChar(10) // YYYY-MM-DD
  title    String
  category String // devotion | work | home | errand
  slot     String // morning | afternoon | evening | anytime

  // The standard time range, both set or both null.
  windowStart Int?
  windowEnd   Int?

  isDone Boolean @default(false)
  doneAt Int? // minutes after midnight; null while not done, and on a tick with no time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, day])
}

// One item of the daily routine: shows on every day from `since` until `until`.
// Never deleted — taking it out sets `until` so the days already lived keep it.
model RoutineDailyItem {
  userId String
  id     String

  title    String
  category String
  slot     String

  windowStart Int?
  windowEnd   Int?

  since String @db.VarChar(10) // first day it applies, YYYY-MM-DD
  until String @default("") @db.VarChar(10) // last day it applies; empty while it is still going

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

// A daily item ticked on a day. The row's existence is the tick.
model RoutineCheck {
  userId String
  itemId String // RoutineDailyItem.id
  day    String @db.VarChar(10)

  doneAt Int? // minutes after midnight; null for a tick made before times were kept

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId, day])
  @@index([userId, day])
}

// ----------------------------------------------------------------------------
// Routine nudges: the verse a standard routine's reminder carries.
//
// The app has a fixed set of standard routines (wakeUp, morningChant, ... — the keys of
// `RoutinePreset` in the app) and schedules a local reminder for each. A reminder's title
// is the task's name and its body is a verse. These two tables are where those verses
// come from, so they can be added to without a release. Not per user.
// ----------------------------------------------------------------------------

// One standard routine. `key` is the app's own name for it.
model RoutineKind {
  key String @id // wakeUp | morningChant | exercise | breakfast | lunch | eveningChant | dinner | scriptureReading | sleep

  sortOrder Int @default(0) // the order of the day

  // The spoken line, with {name} for the person: "Hari Bol {name}, it is time to wake up."
  // Nothing reads it yet. A later job turns it into a voice message per user (the app plays
  // `voiceUrl` when a nudge has one); it lives here so the script is written once, with the kind.
  voiceScript String? @db.Text

  isActive Boolean @default(true)

  nudges RoutineNudge[]
}

// One verse for one kind. A kind has several; the app rotates through them by day.
model RoutineNudge {
  id String @id @default(cuid())

  kindKey String
  kind    RoutineKind @relation(fields: [kindKey], references: [key], onDelete: Cascade)

  // The verse it is about, as `Verse.verseId` ("1.2.69"). A soft link on purpose: the book
  // importers run separately from the seed, so the verse may not be in the database yet, and
  // the nudge must still work. When the verse is there its translation in the reader's
  // language is the body; `text` is what is shown when it is not.
  verseId String?

  reference String // "Bhagavad-gita 2.69", always shown with the text
  text      String @db.Text // the verse's translation, in English — the fallback body

  position Int     @default(0) // order within the kind
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kindKey, position])
  @@index([verseId])
}

// ============================================================================
// Reels — short-form creator video/image posts, and engagement on them
// ============================================================================

// What makes a User a creator. A capability, not a Role — Role/Permission is
// admin-panel access (user/moderator/admin), which has nothing to do with
// whether someone can post reels. Same shape as SadhanaProfile: the row's
// existence is the flag.
model CreatorProfile {
  id String @id @default(cuid())

  userId String @unique

  displayName    String // public name; may differ from User.name
  bio            String? @db.Text
  avatarPath     String? // overrides User.avatarUrl on the creator's public profile
  coverImagePath String?
  socialLinks    Json? // { "youtube": "...", "instagram": "..." }

  status          CreatorStatus @default(PENDING)
  rejectionReason String?
  appliedAt       DateTime      @default(now())
  approvedAt      DateTime?
  approvedById    String? // admin User.id; no relation, same as Ban.liftedById
  isVerified      Boolean       @default(false)

  // Derived caches, checked on every profile view — rebuildable from
  // CreatorFollow / Reel / ReelView at any time, same reasoning as User.isPremium.
  followerCount Int @default(0)
  reelCount     Int @default(0)
  totalViews    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reels     Reel[]
  followers CreatorFollow[]

  @@index([status])
}

model CreatorFollow {
  followerId String
  creatorId  String

  createdAt DateTime @default(now())

  follower User           @relation(fields: [followerId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId])
}

// A reusable visual "look" for auto-generating reels from scripture: a
// background (image or looping video), an optional logo, and where the verse
// text goes. The verse text itself is never baked in here or into the reel —
// it is rendered by the app at watch time, in the viewer's own reading
// language, the same way a translation is (see utils/language.js). That is
// what lets one template produce reels that work for every language without a
// copy of the video per language, and it costs nothing at render time this
// server doesn't already pay for drawing a caption.
model ReelTemplate {
  id String @id @default(cuid())

  name     String
  isActive Boolean @default(true)

  config Json
  // The design every reel made from this template starts from — the same shape
  // the admin reel editor works on, minus what is per reel:
  //   { mediaType: "VIDEO"|"IMAGE", videoPath, images: [path], audioPath,
  //     thumbnailPath, durationMs, width, height,
  //     overlays: [{ id, text, x, y, width, size, style, color, align,
  //                  bind?: "sanskrit"|"transliteration"|"translation"|"reference" }] }
  // Positions and sizes are percentages of the frame, set by dragging in the
  // editor. An overlay with `bind` is filled from each verse when a reel is made
  // — and again whenever it is fetched, so it follows the reader's language.
  // `audioPath` is background music, used when a run does not use the verse's
  // own recitation.

  createdBy String? // admin User.id; no relation, same as Ban.liftedById

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reels Reel[]

  @@index([isActive])
}

// One post. `mediaType` decides where the media actually lives:
//   VIDEO → videoPath, a single file (audio may already be muxed into it)
//   IMAGE → ReelMedia rows, one or more, shown as a slideshow
//   AUDIO → ReelAudioTrack rows, one per language — a recitation or narration
//           with no picture beyond `thumbnailPath`; the reader's language chain
//           picks which row plays, same resolution as everything else in
//           utils/language.js
// `audioTrackPath` is separate from all three — a background track a creator
// adds over a silent video or an image slideshow, the way a Reel/Short works.
// An AUDIO reel has no use for it; the content itself is the audio.
// `templateId` is orthogonal to all of the above: set only on a reel that a
// ReelTemplate generated, it tells the app to draw the linked verse's text
// over the media rather than treating the reel as a plain video/image/audio
// post. mediaType still describes what the *background* is.
model Reel {
  id String @id @default(cuid())

  creatorId String

  mediaType      ReelMediaType
  videoPath      String? // VIDEO only
  audioTrackPath String? // optional background music, either media type
  thumbnailPath  String?
  durationMs     Int?
  width          Int?
  height         Int?

  caption      String?  @db.Text
  tags         String[] @default([]) // hashtags/topics
  languageCode String?  @db.VarChar(10) // spoken/caption language; null = unspecified

  // Ties a reel back into the app's actual content, so "reels about this verse"
  // is a join, not a guess from the caption text.
  verseId  String?
  mantraId String?
  deityId  String?

  // Set only for a reel a ReelTemplate generated — see the model comment above.
  templateId String?

  // Text the admin editor placed on the frame, drawn by the app at watch time.
  // A list of { id, text, x, y, width, size, style, color, align } with x/y/
  // width/size as percentages of the frame — see controllers/admin/reel.js for
  // the schema that guards it. Frozen text, not a live link: `verseId` says
  // where a quoted verse came from, but editing the verse later must not
  // silently change a published reel.
  overlays Json @default("[]")

  // How the app draws it: 'MEDIA' plays the video/audio/images above; 'VERSE_PAGES' draws the
  // reel's verse itself as pages (Sanskrit, meaning, purport) in the reader's reading language —
  // the book reels made from templates. See config/book-reel.js.
  layout String @default("MEDIA") @db.VarChar(20)

  sampradaya String @default("vaishnav") @db.VarChar(50)

  status          ReelStatus @default(PENDING_REVIEW)
  rejectionReason String?
  reviewedById    String? // admin/moderator User.id; no relation, same as Ban.liftedById
  reviewedAt      DateTime?
  publishedAt     DateTime?

  // Denormalised counters, updated alongside the row they summarise (ReelLike,
  // ReelComment, ReelShare, ReelView) so a feed page never has to aggregate them.
  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)
  shareCount   Int @default(0)

  isPinned Boolean @default(false) // pinned to the top of the creator's profile

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  verse    Verse?         @relation(fields: [verseId], references: [id], onDelete: SetNull)
  mantra   Mantra?        @relation(fields: [mantraId], references: [id], onDelete: SetNull)
  deity    Deity?         @relation(fields: [deityId], references: [id], onDelete: SetNull)
  template ReelTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  media       ReelMedia[]
  audioTracks ReelAudioTrack[]
  likes       ReelLike[]
  comments    ReelComment[]
  shares      ReelShare[]
  views       ReelView[]
  reports     ReelReport[]
  favorites   Favorite[]

  @@unique([templateId, verseId]) // "generate" skips a verse already paired with this template
  @@index([tags], type: Gin) // "more like this" matches on the standard tags — see utils/reel-tags.js
  @@index([creatorId])
  @@index([status, publishedAt])
  @@index([verseId])
  @@index([layout, verseId])
  @@index([mantraId])
  @@index([deityId])
  @@index([sampradaya])
}

// One image in an IMAGE reel's slideshow. A single-image reel still gets one
// row here, rather than splitting storage between "the first image" on Reel
// and "the rest" here.
model ReelMedia {
  id String @id @default(cuid())

  reelId       String
  imagePath    String
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([reelId])
}

// One language's track for an AUDIO reel. A reel with only Sanskrit today
// gets one row; a language added later is one more row, not a schema change —
// same shape as ReelMedia, and resolved by the reader's mantra-language chain
// the same way Narration and VerseTranslation are (see utils/language.js).
model ReelAudioTrack {
  id String @id @default(cuid())

  reelId       String
  languageCode String @db.VarChar(10)
  audioPath    String // S3 object key
  durationMs   Int?

  createdAt DateTime @default(now())

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([reelId, languageCode])
  @@index([reelId])
}

model ReelLike {
  userId String
  reelId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@id([userId, reelId])
  @@index([reelId])
}

// Flat model with a self-relation for one level of replies — the controller
// decides how deep it lets threads go, the schema does not need to know.
model ReelComment {
  id String @id @default(cuid())

  reelId   String
  userId   String
  parentId String?

  text String @db.Text

  // Denormalised, same reasoning as the counters on Reel.
  likeCount  Int @default(0)
  replyCount Int @default(0)

  isPinned Boolean @default(false) // creator can pin one comment
  isHidden Boolean @default(false) // moderation takedown, without losing the thread

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reel    Reel              @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ReelComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies ReelComment[]     @relation("CommentReplies")
  likes   ReelCommentLike[]
  reports ReelReport[]

  @@index([reelId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model ReelCommentLike {
  userId    String
  commentId String

  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment ReelComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

// Append-only log, same shape as UserIssue — every share event, not just a
// running total, so which platform actually drives traffic is answerable later.
model ReelShare {
  id String @id @default(cuid())

  reelId String
  userId String? // nullable: a web visitor sharing a public reel page may be signed out

  platform SharePlatform @default(OTHER)

  createdAt DateTime @default(now())

  reel Reel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reelId, createdAt])
  @@index([userId])
}

// One row per user per reel, overwritten on rewatch — same pattern as
// ReadingProgress. Anonymous/logged-out plays are not tracked here; they only
// bump Reel.viewCount directly, since there is no user to dedupe against.
model ReelView {
  id String @id @default(cuid())

  userId String
  reelId String

  watchCount    Int     @default(1) // times (re)watched
  lastWatchedMs Int? // furthest point reached in the most recent watch
  completed     Boolean @default(false) // reached ~90%+ at least once

  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@index([reelId])
  @@index([userId, lastViewedAt])
}

// A user flagging a reel or a comment. Exactly one of reelId/commentId is set
// per row, same convention as Favorite's target columns.
model ReelReport {
  id String @id @default(cuid())

  reelId     String?
  commentId  String?
  reporterId String

  reason ReportReason
  note   String?      @db.Text

  reviewedById String? // admin/moderator User.id; no relation, same as Ban.liftedById
  reviewedAt   DateTime?
  actionTaken  String? // free text: "removed", "warned creator", "dismissed"

  createdAt DateTime @default(now())

  reel     Reel?        @relation(fields: [reelId], references: [id], onDelete: Cascade)
  comment  ReelComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([commentId])
  @@index([reviewedAt])
}

// One job of the admin panel's Translations page: Claude translating the Gita into one
// language. The translated verses themselves live in S3 (json/bhagavat-gita/<lang>/ch-<n>.json);
// this row is only the job — what was asked, where it has got to, what it has cost and, when it
// stopped, why. It is what the page shows after a refresh, while the BullMQ job (which carries
// nothing but this row's id) does the work. See controllers/admin/translation.js.
model TranslationRun {
  id String @id @default(cuid())

  language String @db.VarChar(10) // hi | mr | ta | bn | te | kn | ml
  version  String @db.VarChar(40) // TRANSLATION_VERSION when it was started
  book     String @default("bhagavat-gita") @db.VarChar(40) // bhagavat-gita | srimad-bhagavatam; chapters[] are that book's chapter ids
  provider String @default("anthropic") @db.VarChar(20) // anthropic | openai | gemini — the translation part's (or the first part's) when `plan` is set
  model    String @db.VarChar(100)

  // Which provider, model and effort writes each part: { translation: { provider, model, effort }, purport: …,
  // transliteration: …, wordMeanings: … }. Null on a run made before plans: all four parts by `provider`/`model`.
  // `lanes` is the progress of each group of parts that shares a provider+model+effort (one request per verse),
  // [{ key, parts, provider, model, effort, done, total, calls, costMicros }]; the counters below are their sums.
  plan  Json?
  lanes Json?

  // What the admin asked for. No chapters = all eighteen; no limit or budget = none.
  chapters     Int[]
  verseLimit   Int?
  budgetMicros Int? // millionths of a USD, like AiUsageLog.costMicros

  status          TranslationRunStatus @default(QUEUED)
  pauseReason     String?              @db.VarChar(30) // credit | auth | storage | config | rate_limit | unavailable | error
  statusMessage   String? // the plain-English line the page shows under the status
  stopReason      String?              @db.VarChar(30) // how a COMPLETED run ended: finished | limit | budget
  errorVerseId    String? // the verse a FAILED run stopped on
  resumeAt        DateTime? // set while a PAUSED run is going to try again by itself
  cancelRequested Boolean              @default(false) // the worker polls this; a running job cannot be told directly
  jobId           String? // the BullMQ job currently carrying it
  attempts        Int                  @default(0) // times it has gone to RUNNING
  retriesInARow   Int                  @default(0) // automatic retries since a verse was last saved

  // Progress. totalVerses is fixed when the run first starts: what was left to do then, capped by
  // verseLimit. doneVerses counts the verses this run has saved, across pauses and resumes.
  totalVerses    Int     @default(0)
  doneVerses     Int     @default(0)
  currentVerseId String?
  score1         Int     @default(0) // saved verses by correctness: 1 needs a second round, 3 is perfect
  score2         Int     @default(0)
  score3         Int     @default(0)

  // Spend, summed from every call the run made — also the ones that failed.
  inputTokens   Int @default(0)
  outputTokens  Int @default(0)
  calls         Int @default(0)
  costMicros    Int @default(0)
  activeSeconds Int @default(0) // time spent translating, pauses excluded; what the time-left estimate uses

  requestedById   String? // admin User.id; no relation, same as ReelTemplate.createdBy
  requestedByName String? // their name when they asked, so the page can say who without a lookup

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime? // the worker touches it every few seconds while the job runs

  @@index([status, createdAt])
  @@index([language, createdAt])
}

// ── AI chat ────────────────────────────────────────────────────────────────
// A devotional assistant. See "AI chat" in backend/CLAUDE.md.
//
// Users never see tokens. They see a credit meter derived from AiWallet, and
// every AI operation — chat, summaries, whatever AI feature comes next — debits
// the same wallet through services/ai-wallet.js. Nothing else writes these
// tables.

enum AiWalletTxType {
  CREDIT
  DEBIT
}

enum AiWalletSource {
  CHAT
  SUMMARIZATION
  ADMIN_GRANT
  ADMIN_ADJUST
  PLAN_RENEWAL
  OTHER_AI_FEATURE
  SHARE_IMAGE // a background picture made for a share card
}

enum AiModelTier {
  BASIC
  ADVANCED
}

enum AiRenewal {
  MONTHLY // the wallet is topped back up to its allocation every period
  NEVER // the allocation is a one-time total
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  COMPLETE
  PARTIAL // the stream broke after some text arrived
  STOPPED // the reader pressed stop
  ERROR // nothing usable arrived
}

// What a plan allows in chat. One row per SubscriptionPlan; edited in the admin
// panel's AI chat page and read on every request (cached for a minute), so a
// change applies without a deploy.
model AiPlanConfig {
  id String @id @default(cuid())

  planId String           @unique
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // What the devotee level is called to the reader: "Jigyasu", "Bhakta" …
  levelName String @db.VarChar(50)

  isEnabled Boolean @default(true)

  // Per local day. 0 = no daily cap.
  dailyTokens        Int       @default(0)
  // What 100% of the credit meter means, and how it refills.
  walletTokens       Int       @default(0)
  renewal            AiRenewal @default(MONTHLY)
  // Most tokens one conversation may spend before a fresh chat is asked for. 0 = no cap.
  conversationTokens Int       @default(0)

  modelTier AiModelTier @default(BASIC)

  updatedAt DateTime @updatedAt
}

model AiWallet {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The plan the allocation was last set from, so a plan change is noticed.
  planId String?

  balance     Int // may dip below zero by the estimation error of one reply
  allocation  Int // what 100% means
  periodStart DateTime  @default(now())
  periodEnd   DateTime? // null = never renews

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodEnd])
}

model AiWalletTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   AiWalletTxType
  tokens Int // always positive; `type` says which way
  source AiWalletSource

  // The conversation, message or admin action this came from.
  referenceId String?
  note        String?

  balanceAfter Int
  createdById  String? // the admin, for grants and adjustments

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([source, createdAt])
}

// Tokens spent per user per local day. The row for "today" is simply the one
// whose date is today in the user's timezone, which is why the daily cap resets
// at midnight with no job having to zero anything.
model AiDailyUsage {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        String @db.VarChar(10) // user-local "YYYY-MM-DD"
  tokens      Int    @default(0) // paid from the wallet; this is what the plan's daily cap counts
  // Paid from that day's free-tier bonus instead (services/ai/free-tier.js, utils/ai-bonus.js). Not part of `tokens`,
  // so the bonus never uses up the cap and never touches the wallet.
  bonusTokens Int    @default(0)

  @@id([userId, date])
  @@index([date])
}

model ChatConversation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String @default("New chat") @db.VarChar(120)

  // Everything older than `summarizedThroughSeq`, compressed. Sent to the model
  // in place of those messages, which stay in the table for display.
  contextSummary       String? @db.Text
  summarizedThroughSeq Int     @default(0)

  lastSeq      Int @default(0)
  messageCount Int @default(0)
  tokensUsed   Int @default(0) // spent in this conversation, all operations

  // The chat this one was started from when its limit was reached.
  carriedFromId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  messages ChatMessage[]

  @@index([userId, lastMessageAt])
}

model ChatMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  seq     Int
  role    ChatRole
  content String            @db.Text
  status  ChatMessageStatus @default(COMPLETE)

  // A picture the person sent with this message: a storage key (never a link), the server's own JPEG copy.
  // Removed with the chat — clearing it, deleting it or deleting the account.
  imagePath String? @db.VarChar(500)

  // Local estimate of this message's size — what compaction decisions use.
  tokenCount Int @default(0)

  // From the provider, on an assistant message: what the whole call cost.
  inputTokens  Int?
  outputTokens Int?
  model        String? @db.VarChar(100)

  createdAt DateTime @default(now())

  @@unique([conversationId, seq])
}

// ── Sharing and referrals ─────────────────────────────────────────────────

enum ShareContentType {
  VERSE // a verse or shloka, target = Verse.verseId
  MANTRA // target = Mantra.slug
  REEL // target = Reel.id
}

// A public, opaque code for one piece of content: hariharibol.com/shloka/<code>.
// The code is random, never derived from the target or the sharer, so it exposes
// neither. It is deliberately a separate thing from ReferralCode: opening shared
// content never attributes a referral or earns a reward.
model ShareLink {
  id String @id @default(cuid())

  code        String           @unique @db.VarChar(16)
  type        ShareContentType
  targetId    String           @db.VarChar(120)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Set by an admin to switch a code off without deleting its record.
  revokedAt DateTime?
  clicks    Int       @default(0)

  createdAt DateTime @default(now())

  @@index([type, targetId])
  @@index([createdById, type, targetId])
}

// Each user's own referral code, made on first use. Random and short enough to
// type (it is the fallback when a link does not survive an app install).
model ReferralCode {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String   @unique @db.VarChar(16)
  createdAt DateTime @default(now())
}

enum ReferralStatus {
  PENDING // attributed, not yet qualified
  QUALIFIED // met the rules and was rewarded
  REJECTED // failed a rule for good (see rejectReason)
  REVERSED // the reward was taken back (refund, abuse)
}

enum ReferralSource {
  LINK
  CODE
}

// One row per referred person (`refereeId` is unique: a person is referred once,
// by the first valid code they present — later codes are ignored).
model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId  String @unique
  referee    User   @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  code   String         @db.VarChar(16)
  source ReferralSource @default(LINK)

  status       ReferralStatus @default(PENDING)
  rejectReason String?        @db.VarChar(120)

  attributedAt DateTime  @default(now())
  qualifiedAt  DateTime?

  reward EntitlementGrant?

  @@index([referrerId, status])
  @@index([status, attributedAt])
}

enum EntitlementGrantSource {
  REFERRAL
  ADMIN
}

// Premium access given rather than bought. It is not a store subscription and is
// never shown as one: services/entitlement.js reads it beside Subscription and
// Payment, takes the highest tier, and a grant never shortens or replaces a
// subscription. `referralId` is unique, so a referral can pay out once however
// many times it is evaluated.
model EntitlementGrant {
  id String @id @default(cuid())

  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  source     EntitlementGrantSource
  referralId String?                @unique
  referral   Referral?              @relation(fields: [referralId], references: [id], onDelete: SetNull)
  note       String?                @db.VarChar(200)

  startsAt  DateTime
  endsAt    DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, endsAt])
}

enum ShareImageStatus {
  PENDING
  DONE
  FAILED
}

// One AI-made background for a share card. `(userId, requestKey)` is unique, so a
// retry of the same request finds the same job and cannot be charged twice.
model ShareImageJob {
  id String @id @default(cuid())

  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey String @db.VarChar(80)

  prompt    String           @db.VarChar(600)
  status    ShareImageStatus @default(PENDING)
  tokens    Int
  // Where the picture is kept (S3 key). Removed with the job after a day.
  imagePath String?
  error     String?          @db.VarChar(200)
  refunded  Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, requestKey])
  @@index([createdAt])
}

// One admin-started run that writes video scene prompts for the chapters of a book (admin → Scenes). Same shape as
// TranslationRun, smaller: one AI provider and model, one request per chapter, the output a JSON file per chapter in S3
// (json/<book>/scenes/sk-<canto>-ch-<n>.json). The row is the truth; the BullMQ job only works it.
model SceneRun {
  id String @id @default(cuid())

  book     String @default("srimad-bhagavatam") @db.VarChar(40)
  provider String @default("gemini") @db.VarChar(20)
  model    String @db.VarChar(100)

  chapters Int[] // chapter ids of the book (canto × 100 + chapter for the Bhagavatam); the chapters this run was asked for
  force    Boolean @default(false) // write again chapters that already have a scene file

  status          TranslationRunStatus @default(QUEUED)
  pauseReason     String?              @db.VarChar(30) // credit | auth | config | storage | rate_limit | unavailable | source | error
  statusMessage   String?
  stopReason      String?              @db.VarChar(30) // finished | limit
  errorChapter    Int? // the chapter a FAILED run stopped on
  resumeAt        DateTime?
  cancelRequested Boolean              @default(false)
  jobId           String?
  attempts        Int                  @default(0)
  retriesInARow   Int                  @default(0)

  totalChapters  Int  @default(0)
  doneChapters   Int  @default(0)
  skippedChapters Int @default(0) // chapters with no Hindi meanings to work from
  currentChapter Int?

  inputTokens   Int @default(0)
  outputTokens  Int @default(0)
  calls         Int @default(0)
  activeSeconds Int @default(0)

  requestedById   String?
  requestedByName String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime?

  @@index([status, createdAt])
}

// ============================================================================
// Hindu calendar (panchang)
// ============================================================================

enum FestivalKind {
  EKADASHI
  CHATURTHI // Vinayaka, Sankashti and Ganesh Chaturthi
  PRADOSH
  PURNIMA
  AMAVASYA
  SANKRANTI
  FESTIVAL
}

// One civil day of the panchang for one place. Worked out by services/panchang.js
// (astronomy-engine) and saved by `npm run seed:panchang`; an admin can correct a
// field, which sets `isEdited` so the next seed leaves the row alone.
model PanchangDay {
  id String @id @default(cuid())

  date        DateTime @db.Date
  locationKey String   @db.VarChar(40) // "new-delhi", "ujjain"

  weekday  Int // 0 = Sunday
  sunrise  DateTime?
  sunset   DateTime?
  moonrise DateTime?

  tithiNumber     Int // 1–30 at sunrise
  tithiName       String    @db.VarChar(40)
  paksha          String    @db.VarChar(10) // SHUKLA | KRISHNA
  tithiEndsAt     DateTime?
  nakshatra       String    @db.VarChar(40)
  nakshatraNumber Int
  nakshatraEndsAt DateTime?
  yoga            String    @db.VarChar(40)
  yogaEndsAt      DateTime?
  karana          String    @db.VarChar(40)
  monthAmanta     String    @db.VarChar(40)
  monthPurnimanta String    @db.VarChar(40)
  isAdhika        Boolean   @default(false)
  sunSign         String    @db.VarChar(40)
  moonSign        String    @db.VarChar(40)
  vikramSamvat    Int
  shakaSamvat     Int

  notes    String? @db.Text // an admin's remark shown with the day
  isEdited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, locationKey])
  @@index([locationKey, date])
}

// A festival or observance on a date. `notifyDaysBefore` lists how many days ahead a push
// goes out (1 = the evening before is reached the day before; 0 = the day itself);
// `notifiedDays` records which were sent so a restart never repeats one.
model Festival {
  id String @id @default(cuid())

  date        DateTime     @db.Date
  locationKey String       @db.VarChar(40)
  slug        String       @db.VarChar(80)
  kind        FestivalKind
  name        String       @db.VarChar(120)
  description String?      @db.Text
  paksha      String?      @db.VarChar(10)
  tithiNumber Int?
  month       String?      @db.VarChar(40)
  details     Json? // { vaishnavaDate, anchor, ... }

  isActive         Boolean @default(true)
  notify           Boolean @default(true)
  notifyDaysBefore Int[]   @default([1])
  notifiedDays     Int[]   @default([])
  isEdited         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, locationKey, slug])
  @@index([locationKey, date])
  @@index([date, notify])
}

// What each translated chapter file in S3 holds, counted once and kept here so the admin Translations page reads a
// table instead of ~3,700 objects. One row per book × chapter × language. The worker rewrites a run's rows when it
// stops, and Recount (or the first visit, or a new TRANSLATION_VERSION) refills them from S3. See services/translation.js.
model TranslationProgress {
  book     String @db.VarChar(40)
  chapter  Int // the book's chapter id (canto × 100 + chapter for the Bhagavatam)
  language String @db.VarChar(10)

  total    Int // verses in the chapter
  saved    Int @default(0) // verses with a translation
  upToDate Int @default(0) // saved under `version`, or by a person
  byClaude Int @default(0)
  scores   Json @default("{}") // { 1, 2, 3, unscored }
  versions Json @default("{}") // translation version -> verses
  parts    Json @default("{}") // part -> verses current for it
  status   String @default("EMPTY") @db.VarChar(10) // EMPTY | PARTIAL | COMPLETE
  version  String? @db.VarChar(40) // the TRANSLATION_VERSION `upToDate` was worked out under
  s3Key    String @db.VarChar(200)

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([book, chapter, language])
  @@index([book, language])
}


// One row per person per (Indian) calendar day on which they used the app or the website — the history behind
// daily / weekly / monthly active users and retention. `User.lastActiveAt` only says when someone was last seen,
// so it cannot answer "how many people were active last Tuesday". Written by the auth middleware at most once a
// day per person (see middleware/auth.js), and backfilled once from older activity by the migration.
model UserActiveDay {
  userId String
  date   DateTime @db.Date

  firstSeenAt DateTime @default(now())
  platform    String?  @db.VarChar(20) // "ios" | "android" | "web", from the first request of the day

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
  @@index([date])
}
