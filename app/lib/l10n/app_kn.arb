  "settingsSectionAbout": "ಆ್ಯಪ್ ಬಗ್ಗೆ",
  "sourcesTitle": "ಮೂಲಗಳು ಮತ್ತು ಹಕ್ಕು ನಿರಾಕರಣೆ",
  "sourcesIntro": "HariHariBol ದೈನಂದಿನ ಓದು ಮತ್ತು ಜಪಕ್ಕಾಗಿ ಪವಿತ್ರ ಗ್ರಂಥಗಳನ್ನು ನೀಡುತ್ತದೆ. ಇದನ್ನು ಸಾಧ್ಯವಾಗಿಸಿದ ಆಚಾರ್ಯರು, ಅನುವಾದಕರು ಮತ್ತು ವಿದ್ವಾಂಸರಿಗೆ ನಾವು ಕೃತಜ್ಞರು. ಈ ಗ್ರಂಥಗಳನ್ನು ಎಲ್ಲಿಂದ ಪಡೆಯಲಾಗಿದೆ ಮತ್ತು ಹೇಗೆ ನೀಡಲಾಗಿದೆ ಎಂಬುದನ್ನು ಈ ಪುಟ ವಿವರಿಸುತ್ತದೆ.",
  "sourcesTextsHeading": "ಅನುವಾದಗಳು ಮತ್ತು ವ್ಯಾಖ್ಯಾನಗಳು",
  "sourcesAuthorCredit": "ಭಗವದ್ಗೀತೆ ಯಥಾರೂಪ ಮತ್ತು ಶ್ರೀಮದ್ಭಾಗವತದ ಇಂಗ್ಲಿಷ್ ಅನುವಾದ ಮತ್ತು ತಾತ್ಪರ್ಯಗಳು ಅಂತಾರಾಷ್ಟ್ರೀಯ ಕೃಷ್ಣಪ್ರಜ್ಞಾ ಸಂಘದ ಸಂಸ್ಥಾಪಕಾಚಾರ್ಯರಾದ ಕೃಷ್ಣಕೃಪಾಮೂರ್ತಿ ಶ್ರೀ ಶ್ರೀಮದ್ ಎ. ಸಿ. ಭಕ್ತಿವೇದಾಂತ ಸ್ವಾಮಿ ಪ್ರಭುಪಾದರ ಕೃತಿಗಳು. © The Bhaktivedanta Book Trust International, Inc.",
  "sourcesTextsBody": "ಪ್ರತಿಯೊಂದು ಅನುವಾದ, ತಾತ್ಪರ್ಯ ಮತ್ತು ವ್ಯಾಖ್ಯಾನವು ಅದರ ಕರ್ತೃವಿನ ಕೃತಿ, ಮತ್ತು ಅದರ ಮೇಲಿನ ಎಲ್ಲ ಹಕ್ಕುಗಳು ಅದರ ಕರ್ತೃಗಳು ಮತ್ತು ಪ್ರಕಾಶಕರಲ್ಲೇ ಉಳಿಯುತ್ತವೆ. ಇವುಗಳನ್ನು ಇಲ್ಲಿ ವೈಯಕ್ತಿಕ ಭಕ್ತಿ ಅಧ್ಯಯನಕ್ಕಾಗಿ ನೀಡಲಾಗಿದೆ, ಮರುಹಂಚಿಕೆಗಾಗಿ ಅಲ್ಲ.",
  "sourcesFromHeading": "ಗ್ರಂಥಗಳನ್ನು ಎಲ್ಲಿಂದ ಪಡೆಯಲಾಗಿದೆ",
  "sourcesGita": "ಭಗವದ್ಗೀತೆ: ಸಂಸ್ಕೃತ ಮೂಲಪಾಠ, ಇಂಗ್ಲಿಷ್ ಅನುವಾದ ಮತ್ತು ತಾತ್ಪರ್ಯ, ಹಾಗೂ ಶ್ರೀ ರಾಮಾನುಜಾಚಾರ್ಯರು, ಶ್ರೀ ಮಧ್ವಾಚಾರ್ಯರು ಮತ್ತು ಶ್ರೀಧರ ಸ್ವಾಮಿಗಳ ವ್ಯಾಖ್ಯಾನಗಳು",
  "sourcesBhagavatam": "ಶ್ರೀಮದ್ಭಾಗವತ, ಸ್ಕಂಧ {from}–{to}: ಸಂಸ್ಕೃತ ಮೂಲಪಾಠ, ಇಂಗ್ಲಿಷ್ ಅನುವಾದ ಮತ್ತು ತಾತ್ಪರ್ಯ",
  "sourcesDnyaneshwari": "ಜ್ಞಾನೇಶ್ವರಿ: ಭಗವದ್ಗೀತೆಯ ಮೇಲೆ ಸಂತ ಜ್ಞಾನೇಶ್ವರರ ಮರಾಠಿ ಓವಿಗಳು",
  "sourcesAiHeading": "ಇತರ ಭಾಷೆಗಳಲ್ಲಿ ಅನುವಾದ",
  "sourcesAiBody": "ಹಿಂದಿ, ಮರಾಠಿ ಮತ್ತು ಇತರ ಭಾರತೀಯ ಭಾಷೆಗಳಲ್ಲಿನ ಪಠ್ಯ — ಅನುವಾದಗಳು, ತಾತ್ಪರ್ಯಗಳು ಮತ್ತು ಆ್ಯಪ್‌ನ ಸ್ವಂತ ಪದಗಳು — ಇಂಗ್ಲಿಷ್‌ನಿಂದ AI ಸಹಾಯದಿಂದ ಸಿದ್ಧಪಡಿಸಲಾಗಿದೆ. ಇದು ಅಧಿಕೃತ ಅಥವಾ ಅನುಮೋದಿತ ಅನುವಾದವಲ್ಲ ಮತ್ತು ಇದರಲ್ಲಿ ತಪ್ಪುಗಳಿರಬಹುದು; ಅವು ಗಮನಕ್ಕೆ ಬಂದ ಕೂಡಲೇ ನಾವು ಸರಿಪಡಿಸುತ್ತೇವೆ. ಅಧ್ಯಯನಕ್ಕೆ ಸಂಸ್ಕೃತ ಮತ್ತು ಮೂಲ ಇಂಗ್ಲಿಷ್ ಪಠ್ಯವೇ ಪ್ರಮಾಣ.",
  "sourcesSakhaBody": "Sakha ಒಬ್ಬ ಡಿಜಿಟಲ್ ಸಂಗಾತಿ, ಗುರುವಲ್ಲ. ಅದರ ಉತ್ತರಗಳು ಯಾವುದೇ ಆಚಾರ್ಯರ ವಚನಗಳಲ್ಲ ಮತ್ತು ಅವುಗಳಲ್ಲಿ ತಪ್ಪಾಗಬಹುದು; ಯಾವುದೇ ಮುಖ್ಯ ವಿಷಯವನ್ನು ಗ್ರಂಥಗಳೊಂದಿಗೆ ತಪ್ಪದೇ ಹೋಲಿಸಿ ನೋಡಿ.",
  "sourcesIndependentHeading": "ಒಂದು ಸ್ವತಂತ್ರ ಪ್ರಯತ್ನ",
  "sourcesIndependentBody": "HariHariBol ಒಂದು ಸ್ವತಂತ್ರ ಭಕ್ತಿ ಪ್ರಯತ್ನ. ಇದು ಯಾವುದೇ ದೇವಾಲಯ, ಸಂಸ್ಥೆ ಅಥವಾ ಪ್ರಕಾಶಕರೊಂದಿಗೆ ಸಂಯೋಜಿತವಾಗಿಲ್ಲ, ಅವರಿಂದ ಅನುಮೋದಿತವಾಗಿಲ್ಲ ಮತ್ತು ಅವರ ಪರವಾಗಿ ಮಾತನಾಡುವುದಿಲ್ಲ.",
  "sourcesContactHeading": "ಹಕ್ಕುಗಳು ಮತ್ತು ತಿದ್ದುಪಡಿಗಳು",
  "sourcesContactBody": "ಇಲ್ಲಿ ತೋರಿಸಿರುವ ಯಾವುದೇ ಪಠ್ಯದ ಮೇಲೆ ನಿಮಗೆ ಹಕ್ಕುಗಳಿದ್ದರೆ, ಅಥವಾ ಅದರಲ್ಲಿ ತಪ್ಪು ಕಂಡುಬಂದರೆ, ದಯವಿಟ್ಟು ನಮಗೆ ಬರೆಯಿರಿ. ನಾವು ಶೀಘ್ರವಾಗಿ ಉತ್ತರಿಸುತ್ತೇವೆ ಮತ್ತು ಕೇಳಿದರೆ ಅದನ್ನು ಸರಿಪಡಿಸುತ್ತೇವೆ ಅಥವಾ ತೆಗೆದುಹಾಕುತ್ತೇವೆ.",
