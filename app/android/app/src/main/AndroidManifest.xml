<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter's template declares this only in the debug and profile
         manifests, so a release build has no network unless a library happens
         to bring the permission in. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Auto-count listens to the mic to recognise a known mantra's own
         sound, entirely on-device — see core/constants/auto_chant_config.dart. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Reading aloud keeps playing with the screen off (audio_service): a
         foreground media service, and a wake lock so the CPU keeps making speech. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Routine alerts are set with the system's alarm clock, which forgets them
         when the phone restarts; this lets the plugin set them again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Lets a routine alert come at the very minute its task's time range opens
         (an exact alarm). On Android 14 and later the reader grants it in
         settings, from a card on the routine screen; without it the alerts are
         still set, inexact, and Android may hold one a few minutes. Deliberately
         not USE_EXACT_ALARM: Google Play keeps that one for alarm-clock and
         calendar apps and asks for a declaration (RoutineAlertService). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- A phone is not required: on Android TV there is no touchscreen, and the
         leanback launcher needs the app to say it can run without one. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <application
        android:label="hariharibol"
        android:banner="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
            <!-- Shared verses, mantras, reels and invitations on hariharibol.com. autoVerify makes
                 Android check https://hariharibol.com/.well-known/assetlinks.json (served by the
                 deeplink container from ANDROID_CERT_SHA256); until that lists this app's signing
                 certificate the links open in the browser, which shows the page and its Open button. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="hariharibol.com" android:pathPrefix="/shloka/"/>
                <data android:scheme="https" android:host="hariharibol.com" android:pathPrefix="/naam/"/>
                <data android:scheme="https" android:host="hariharibol.com" android:pathPrefix="/darshan/"/>
                <data android:scheme="https" android:host="hariharibol.com" android:pathPrefix="/satsang/"/>
                <data android:scheme="https" android:host="hariharibol.com" android:path="/get-app"/>
            </intent-filter>
            <!-- The website's "Open in the app" button: hariharibol://open?path=/shloka/<code>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="hariharibol"/>
            </intent-filter>
        </activity>
        <!-- Lock-screen and notification controls for reading aloud. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>
        <!-- Routine alerts (flutter_local_notifications): the alarm that shows one,
             setting them again after a restart or an update of the app, and the
             "Mark as done" button on it. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>
        <!-- How a push notification looks. Firebase shows the notification itself
             while the app is closed or in the background, so without these it
             falls back to the launcher icon, which Android draws as a plain
             square. The icon is a single-colour shape — see ic_stat_feather.xml. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_feather" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Speaking a message to Sakha uses the phone's own speech service
             (speech_to_text). From Android 11 the app must ask to see it. The
             camera needs no permission here: the picture is taken by the
             camera app, through an intent. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
