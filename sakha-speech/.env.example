# Copy to .env (gitignored) and fill in. ./setup.sh makes the copy for you.

# Where the text comes from: the public website API, no login needed.
SAKHA_API_BASE=https://api.hariharibol.com

# Upload (and --source s3). The same bucket and region the backend uses.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=hariharibol-media
# Audio lands under s3://$S3_BUCKET/$S3_NARRATION_PREFIX/<book>/<lang>/<voice>/...
S3_NARRATION_PREFIX=narration

# cuda, mps or cpu. Empty picks the best one this machine has.
SAKHA_DEVICE=
# Where cached text, audio and manifests are kept. Default: ./work
SAKHA_WORK_DIR=
