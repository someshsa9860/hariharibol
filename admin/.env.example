# The backend API this panel talks to.
VITE_API_URL=http://localhost:4000

# OAuth 2.0 **Web** client ID from the same Google Cloud project as the app
# (Google Cloud Console → APIs & Services → Credentials). This must be one of
# the ids already listed in backend's GOOGLE_CLIENT_IDS, or sign-in will be
# rejected server-side.
VITE_GOOGLE_CLIENT_ID=
