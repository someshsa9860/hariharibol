# Copy to .env.local. Every value has a working default except the sign-in client ids.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The API the browser calls. Its CORS list must include the site's origin (WEB_BASE_URL in backend/.env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional: how the Next server reaches the API when that differs (a docker network name, for instance).
# API_BASE_URL=http://api:4000

# Where Apple's popup returns to (registered for the Services ID). Written into the build.
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# The values below are read by the running server on each request and handed to the browser (lib/runtime-config.ts),
# so they are not written into the build. On the server they live in the backend's .env (deploy/server/.env), under
# these same names; here they are only for `npm run dev` and a local `node server.js`.

# Sign in with Google: the *web* OAuth client id. It must also be in the API's GOOGLE_CLIENT_IDS.
WEBSITE_GOOGLE_CLIENT_ID=
# Sign in with Apple (optional): the Services ID. It must also be in the API's APPLE_BUNDLE_IDS.
WEBSITE_APPLE_CLIENT_ID=

# App Check, needed only when the API runs with APP_CHECK_ENABLED=true (production).
# The Firebase web app config as one line of JSON, and a reCAPTCHA Enterprise site key.
WEBSITE_FIREBASE_CONFIG=
WEBSITE_RECAPTCHA_SITE_KEY=
