# Copy to .env.local. Every value has a working default except the sign-in client ids.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The API the browser calls. Its CORS list must include the site's origin (WEB_BASE_URL in backend/.env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Optional: how the Next server reaches the API when that differs (a docker network name, for instance).
# API_BASE_URL=http://api:4000

# Sign in with Google: the *web* OAuth client id. It must also be in the API's GOOGLE_CLIENT_IDS.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sign in with Apple (optional): the Services ID, and a redirect URI registered for it.
# It must also be in the API's APPLE_BUNDLE_IDS.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# App Check, needed only when the API runs with APP_CHECK_ENABLED=true (production).
# The Firebase web app config as one line of JSON, and a reCAPTCHA Enterprise site key.
NEXT_PUBLIC_FIREBASE_CONFIG=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: the realtime websocket (group chanting hears about invitations and live rooms through it).
# Default: the API's host at /ws, or port 4001 on localhost.
# NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws
