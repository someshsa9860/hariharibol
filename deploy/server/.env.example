# Copy to .env on the server. Do not commit the real file.
# The database is managed (RDS). deploy/create-database.sh creates it and writes the next line for you; the
# password is URL-encoded there. sslmode=require is needed for RDS.
# Image names and memory limits are not here: they are in config.sh.
DATABASE_URL=postgresql://hariharibol:replace-with-a-strong-password@your-instance.ap-south-1.rds.amazonaws.com:5432/hariharibol?sslmode=require
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
PORT=4000
WS_PORT=4001
DEEPLINK_PORT=4002
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:8080
GOOGLE_SERVICE_ACCOUNT_PATH=/app/secrets/hari-hari-bol-service-account.json
# Admin panel → Translations. Without ANTHROPIC_API_KEY the page says so and Start is disabled. The api and
# worker both read it: the api estimates and shows the output, the worker translates. The translations are read
# from and saved to the app's own bucket (S3_BUCKET above, json/bhagavat-gita/), with the AWS keys already here —
# those keys must be allowed to WRITE under json/bhagavat-gita/ and json/reports/, and to copy to json-backup-*/.
ANTHROPIC_API_KEY=
TRANSLATION_VERSION=1.0-12-10-26
# The website (website.sh) reads these four from this same file, and only these: it never gets the lines above. They are
# public values (the browser needs them), applied by `./deploy.sh website` — a restart, no new build. Leave one empty
# and that feature is off: no Google id means no web sign-in. The Google id must also be added to GOOGLE_CLIENT_IDS and
# the Apple Services ID to APPLE_BUNDLE_IDS, or the API rejects the token. Optional WEBSITE_API_URL is how the website
# container reaches the API (default https://api.hariharibol.com); it is not API_BASE_URL, which is the API's own.
WEBSITE_GOOGLE_CLIENT_ID=
WEBSITE_APPLE_CLIENT_ID=
# The Firebase web app config as one line of JSON, and a reCAPTCHA Enterprise site key: App Check, needed only while
# the API runs with APP_CHECK_ENABLED=true.
WEBSITE_FIREBASE_CONFIG=
WEBSITE_RECAPTCHA_SITE_KEY=
