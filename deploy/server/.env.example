# Copy to .env on the server. Do not commit the real file.
POSTGRES_DB=hariharibol
POSTGRES_USER=hariharibol
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://hariharibol:replace-with-a-strong-password@postgres:5432/hariharibol
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
PORT=4000
WS_PORT=4001
DEEPLINK_PORT=4002
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:8080
GOOGLE_SERVICE_ACCOUNT_PATH=/app/secrets/hari-hari-bol-service-account.json
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
BACKEND_REPOSITORY=hariharibol-backend
ADMIN_REPOSITORY=hariharibol-admin
API_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=512m
SOCKET_MEMORY_LIMIT=256m
DEEPLINK_MEMORY_LIMIT=256m
ADMIN_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=256m
